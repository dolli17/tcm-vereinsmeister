---
import { getAllMatches, isMatchPlayed } from '../lib/standings';
import doppelData from '../data/doppel.json';
import mixedDoppelData from '../data/mixed-doppel.json';

// Soll-Gesamtanzahl pro Konkurrenz (Gruppe + komplette KO-Phase ohne Spiel
// um Platz 3). Wer hier dreht, weil eine Konkurrenz wegfällt oder anders
// strukturiert wird, sollte den Kommentar mit aktualisieren.
const SOLL = {
  herrenEinzel: 60 + 15, // 8 Gruppen (60) + Achtel/VF/HF/F (8+4+2+1)
  damenEinzel: 16 + 3, // 2 Gruppen (16) + HF/F (2+1)
  herrenDoppel: 14, // 16er-KO mit 1 Freilos: 7 R1 + 4 VF + 2 HF + 1 F
  damenDoppel: 7, // 8er-KO: 4 VF + 2 HF + 1 F
  mixedDoppel: 10, // 16er-KO mit 5 Freilosen: 3 R1 + 4 VF + 2 HF + 1 F
};
const total = Object.values(SOLL).reduce((a, b) => a + b, 0);

const isMatchEntryPlayed = (m: { sieger: 'A' | 'B' | null }) => m.sieger === 'A' || m.sieger === 'B';

const herrenEinzelPlayed = getAllMatches(undefined, 'herren').filter(isMatchPlayed).length;
const damenEinzelPlayed = getAllMatches(undefined, 'damen').filter(isMatchPlayed).length;
const herrenDoppelPlayed = doppelData.matches.filter(isMatchEntryPlayed).length;
const mixedDoppelPlayed = mixedDoppelData.runden
  .flatMap((r) => r.matches)
  .filter(isMatchEntryPlayed).length;

const gespielt = herrenEinzelPlayed + damenEinzelPlayed + herrenDoppelPlayed + mixedDoppelPlayed;
---

<header class="border-b border-deep-ink/10 bg-warm-sand">
  <div class="mx-auto max-w-5xl px-4 pt-7 pb-6 sm:px-8 sm:pt-14 sm:pb-9">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <div class="label-mono text-club-blue">TC Muckensturm · Saison 2026</div>
        <h1 class="mt-2 max-w-[10ch] font-serif text-[44px] leading-[0.94] text-deep-ink sm:max-w-none sm:text-5xl">
          Vereins&shy;meisterschaft
        </h1>
      </div>

      <div class="hidden border-l border-deep-ink/12 pl-4 text-right sm:block">
        <div class="label-mono text-muted-2">Spiele</div>
        <div class="mt-1 font-mono text-sm tabular-nums text-deep-ink">{gespielt}/{total}</div>
      </div>
    </div>

    <div class="mt-5 grid gap-3 border-t border-deep-ink/10 pt-4 sm:mt-6 sm:grid-cols-[1fr_auto] sm:items-end">
      <p class="max-w-2xl text-[15px] leading-relaxed text-muted sm:text-lg">
        Live-Tabellen, Spielplan und Ergebnisse von Mai bis September.
      </p>
      <div class="flex items-center justify-between gap-3 rounded-sm border border-deep-ink/10 bg-white/35 px-3 py-2 sm:hidden">
        <span class="label-mono text-muted-2">Spiele</span>
        <span class="font-mono text-sm tabular-nums text-deep-ink">{gespielt}/{total}</span>
      </div>
    </div>
  </div>
</header>
