---
import { computeStandings, getMatches, getSpielerOfGruppe } from '../lib/standings';
import MatchZeile from './MatchZeile.astro';

type Props = { gruppe: number };
const { gruppe } = Astro.props;

const spieler = getSpielerOfGruppe(gruppe);
const standings = computeStandings(gruppe);
const matchesMai = getMatches(gruppe, 'Mai');
const matchesJuni = getMatches(gruppe, 'Juni');
const matchesJuli = getMatches(gruppe, 'Juli');
const gesetzt = spieler.find((s) => s.gesetzt);
const standingRows = standings.map((row) => ({ ...row, qualifiziert: row.platz <= 2 }));
---

<section class="overflow-hidden rounded-sm border border-deep-ink/10 bg-white/60 shadow-[0_10px_34px_-30px_rgba(26,31,46,0.55)] backdrop-blur-sm" data-gruppe={gruppe}>
  <header class="grid gap-3 border-b border-deep-ink/10 bg-warm-sand-2/40 px-3.5 py-3.5 sm:flex sm:items-baseline sm:justify-between sm:px-6">
    <div>
      <div class="label-mono text-club-blue">Gruppe {gruppe}</div>
      <div class="mt-0.5 font-mono text-[11px] text-muted-2">{spieler.length} Spieler · {matchesMai.length + matchesJuni.length + matchesJuli.length} Spiele</div>
    </div>
    {gesetzt && (
      <div class="flex items-baseline justify-between gap-3 rounded-sm border border-deep-ink/10 bg-white/35 px-3 py-2 sm:block sm:border-0 sm:bg-transparent sm:p-0 sm:text-right">
        <div class="label-mono text-muted-2">Gesetzt</div>
        <div class="mt-0.5 font-serif text-[15px] text-deep-ink">{gesetzt.name}</div>
      </div>
    )}
  </header>

  {/* Tabelle */}
  <div class="px-2 pt-3 sm:overflow-x-auto sm:px-4">
    <table class="w-full table-fixed border-collapse text-[12px] sm:min-w-[420px] sm:table-auto sm:text-[13px]">
      <thead>
        <tr class="border-b border-deep-ink/15">
          <th class="label-mono w-6 px-1 py-2 text-left text-muted-2 sm:w-7">#</th>
          <th class="label-mono px-1.5 py-2 text-left text-muted-2 sm:px-2">Spieler</th>
          <th class="label-mono w-8 px-1 py-2 text-center text-muted-2 sm:w-9" title="Spiele">Sp</th>
          <th class="label-mono hidden w-9 px-1 py-2 text-center text-muted-2 min-[380px]:table-cell" title="Siege">S</th>
          <th class="label-mono hidden w-14 px-1 py-2 text-center text-muted-2 sm:table-cell" title="Sätze">Sätze</th>
          <th class="label-mono hidden w-14 px-1 py-2 text-center text-muted-2 md:table-cell" title="Spiele/Games">Games</th>
          <th class="label-mono w-10 px-1 py-2 text-right text-muted-2 sm:w-9">Pkt</th>
        </tr>
      </thead>
      <tbody>
        {standingRows.map((row) => (
          <tr class={`border-b border-deep-ink/8 last:border-b-0 ${row.qualifiziert ? 'bg-club-blue/6' : ''}`}>
            <td class="px-1 py-2.5 font-mono text-[11px] tabular-nums text-muted-2">{row.platz}</td>
            <td class="min-w-0 px-1.5 py-2.5 sm:px-2">
              <span class={`block truncate ${row.qualifiziert ? 'font-semibold text-deep-ink' : 'text-deep-ink'}`}>{row.name}</span>
              {row.qualifiziert && (
                <span class="mt-1 block font-mono text-[9px] uppercase tracking-[1px] text-club-blue">
                  Achtelfinale
                </span>
              )}
            </td>
            <td class="px-1 py-2.5 text-center font-mono tabular-nums text-deep-ink">{row.gespielt}</td>
            <td class="hidden px-1 py-2.5 text-center font-mono tabular-nums text-deep-ink min-[380px]:table-cell">{row.siege}</td>
            <td class="hidden px-1 py-2.5 text-center font-mono text-[12px] tabular-nums text-muted sm:table-cell">
              {row.saetzeGewonnen}:{row.saetzeVerloren}
            </td>
            <td class="hidden px-1 py-2.5 text-center font-mono text-[12px] tabular-nums text-muted md:table-cell">
              {row.spieleGewonnen}:{row.spieleVerloren}
            </td>
            <td class="px-1 py-2.5 text-right font-mono font-semibold tabular-nums text-deep-ink">{row.punkte}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {/* Spielplan */}
  <details class="match-details border-t border-deep-ink/10">
    <summary class="match-summary">
      <span>
        <span class="label-mono block text-court-red">Spielplan</span>
        <span class="mt-1 block font-mono text-[11px] text-muted-2">
          {matchesMai.length + matchesJuni.length + matchesJuli.length} Matches anzeigen
        </span>
      </span>
      <span class="match-summary-mark" aria-hidden="true"></span>
    </summary>

    <div class="px-2 py-3.5 sm:px-4 sm:py-4">
      {[
        { name: 'Mai', list: matchesMai },
        { name: 'Juni', list: matchesJuni },
        { name: 'Juli', list: matchesJuli },
      ].map((monat) => (
        monat.list.length > 0 && (
          <div class="mb-3 last:mb-0" data-monat={monat.name}>
            <div class="label-mono mb-1.5 px-1 text-court-red">{monat.name}</div>
            <div>
              {monat.list.map((m) => <MatchZeile match={m} />)}
            </div>
          </div>
        )
      ))}
    </div>
  </details>
</section>

<style>
  .match-summary {
    cursor: pointer;
    display: flex;
    min-height: 56px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem 0.9rem;
    list-style: none;
  }
  .match-summary::-webkit-details-marker {
    display: none;
  }

  .match-summary-mark {
    position: relative;
    width: 30px;
    height: 30px;
    flex: 0 0 auto;
    border: 1px solid rgba(26, 31, 46, 0.16);
    border-radius: 999px;
  }
  .match-summary-mark::before,
  .match-summary-mark::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1px;
    background: var(--color-deep-ink);
    content: "";
    transform: translate(-50%, -50%);
  }
  .match-summary-mark::after {
    transform: translate(-50%, -50%) rotate(90deg);
    transition: opacity 0.18s ease;
  }
  .match-details[open] .match-summary-mark::after {
    opacity: 0;
  }
</style>
