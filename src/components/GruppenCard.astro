---
import { computeStandings, formatResult } from '../lib/standings';
import { getEnrichedMatches, isPlayed, monthIndex, type Competition } from '../lib/tournament';

type Props = { competition: Competition; gruppe: number; index: number };
const { competition, gruppe, index } = Astro.props;

const standings = computeStandings(competition.id, gruppe);
const matches = getEnrichedMatches(competition.id)
  .filter((m) => m.gruppe === gruppe)
  .sort((a, b) => (a.monat ? monthIndex(a.monat) : 99) - (b.monat ? monthIndex(b.monat) : 99) || a.nr - b.nr);
const played = matches.filter(isPlayed).length;
const collapseId = `grp-${competition.id}-${gruppe}`;
const result = formatResult;

// Internationale wa.me-Nummer aus einer beliebig formatierten Telefonnummer.
function whatsappHref(telefon: string): string {
  const d = telefon.replace(/\D/g, '');
  const intl = d.startsWith('00') ? d.slice(2) : d.startsWith('0') ? `49${d.slice(1)}` : d;
  return `https://wa.me/${intl}`;
}
const telHref = (t: string) => `tel:${t.replace(/[^\d+]/g, '')}`;

const WA = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5.1-4.5-.1-.2-1.2-1.6-1.2-3 0-1.4.7-2.1 1-2.4.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .5l-.4.6c-.1.1-.3.3-.1.6.1.3.6 1 1.3 1.6.9.8 1.6 1 1.9 1.2.2.1.4.1.6-.1l.7-.8c.2-.2.4-.2.6-.1l1.8.9c.2.1.4.2.5.3.1.2.1.9-.1 1.6z"/></svg>';
const TEL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7.1 4.1 8.3 6.7 7 8c.6 1.5 1.7 2.7 3.1 3.1l1.3-1.3 2.6 1.2-.2 2.2c0 .5-.4.9-.9.9-4.4-.1-8-3.7-8.1-8.1 0-.5.4-.9.9-.9l2.4-.1Z"/></svg>';
---

<div class="card fade-in">
  <div class="card-head">
    <span class="grp-no">{gruppe}</span>
    <span style="flex:1;min-width:0">
      <span class="ttl" style="display:block">Gruppe {gruppe}</span>
      <span style="display:block;font-size:.72rem;color:var(--muted);font-weight:500">{standings.length} Spieler</span>
    </span>
    <span class="sub">{played}/{matches.length}</span>
  </div>
  <table class="standings">
    <thead><tr>
      <th class="pos">#</th><th>Spieler</th>
      <th class="num">Sp</th><th class="num">Sätze</th><th class="pts">Pkt</th>
    </tr></thead>
    <tbody>
      {standings.map((row) => (
        <tr data-q={row.platz <= 2 ? '1' : '0'}>
          <td class="pos">{row.platz}</td>
          <td class="player">
            <span class="player-cell">
              <span class="nm">{row.name}</span>
              {row.platz <= 2 && <span class="q-flag">Quali</span>}
              {row.telefon && (
                <span class="contact">
                  <a class="cico wa" href={whatsappHref(row.telefon)} target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp an ${row.name}`} set:html={WA} />
                  <a class="cico tel" href={telHref(row.telefon)} aria-label={`${row.name} anrufen`} set:html={TEL} />
                </span>
              )}
            </span>
          </td>
          <td class="num dim">{row.gespielt}</td>
          <td class="num dim">{row.saetzeGewonnen}:{row.saetzeVerloren}</td>
          <td class="pts"><span class="v">{row.punkte}</span></td>
        </tr>
      ))}
    </tbody>
  </table>
  <button class="card-foot" data-collapse={collapseId} aria-expanded="false">
    Gruppen-Spielplan ansehen
    <span style="color:var(--muted);font-family:var(--font-mono);font-size:.74rem">({played}/{matches.length})</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
  </button>
  <div class="gcollapse" id={collapseId}>
    <div class="matchlist">
      {matches.map((m) => (
        <div class="match">
          <div class="match-no">#{m.nr}</div>
          <div class="match-body">
            <div class={`match-side ${m.sieger === 'A' ? 'win' : ''}`}><span class="nm">{m.sideA}</span></div>
            <div class="match-vs">vs</div>
            <div class={`match-side ${m.sieger === 'B' ? 'win' : ''}`}><span class="nm">{m.sideB}</span></div>
          </div>
          <div class="match-meta">
            {isPlayed(m)
              ? <span class="score">{result(m)}</span>
              : <span class="status-tag open">{m.monat ? `${m.monat} · offen` : 'offen'}</span>}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
