---
import damenDoppelData from '../data/damen-doppel.json';
import KOView from './KOView.astro';

const matches = (damenDoppelData.matches ?? []).map((match) => ({
  nr: match.nr,
  teamA: match.doppelA,
  teamB: match.doppelB,
  termin: match.termin,
  satz1: match.satz1,
  satz2: match.satz2,
  mtb: match.mtb,
  sieger: match.sieger,
}));
---

<KOView
  headline="Damen Doppel"
  konkurrenzLabel="Damen Doppel"
  aktuelleRunde="1. Runde"
  hinweis="Die 1. Runde im Damen Doppel ist im Mai zu spielen. Bitte stimmt eure Termine selbstständig ab und meldet sie vor dem Spiel dem Sportwart."
  runden={[{ name: '1. Runde', matches }]}
/>
