---
type Match = {
  nr: number;
  teamA: string | null;
  teamB: string | null;
  termin: string | null;
  satz1: string | null;
  satz2: string | null;
  mtb: string | null;
  sieger: 'A' | 'B' | null;
};

type Runde = {
  name: string;
  matches: Match[];
};

interface Props {
  headline: string;
  aktuelleRunde?: string;
  hinweis: string;
  runden: Runde[];
  konkurrenzLabel?: string;
}

const {
  headline,
  aktuelleRunde = runden?.[0]?.name ?? '',
  hinweis,
  runden = [],
  konkurrenzLabel = headline,
} = Astro.props;

const isEmpty = runden.length === 0 || runden.every((runde) => runde.matches.length === 0);

function isPlayed(match: Match): boolean {
  return match.sieger === 'A' || match.sieger === 'B';
}

function formatResult(match: Match): string {
  return [match.satz1, match.satz2, match.mtb].filter(Boolean).join(' · ');
}

function matchStatus(match: Match): 'gespielt' | 'terminiert' | 'offen' {
  if (isPlayed(match)) return 'gespielt';
  if (match.termin) return 'terminiert';
  return 'offen';
}
---

{isEmpty ? (
  <div class="rounded-sm border border-dashed border-deep-ink/15 bg-white/40 p-8 text-center sm:p-12">
    <div class="label-mono text-court-red">KO-Baum</div>
    <h2 class="mt-3 font-serif text-2xl text-deep-ink sm:text-3xl">Auslosung folgt</h2>
    <p class="mx-auto mt-3 max-w-md text-sm text-muted">Sobald die Paarungen stehen, erscheint der Turnierbaum hier.</p>
  </div>
) : (
  <div class="space-y-5 sm:space-y-6">
    <section class="rounded-sm border border-club-blue/25 bg-white/60 px-4 py-3.5 shadow-[0_10px_34px_-30px_rgba(26,31,46,0.55)] backdrop-blur-sm sm:px-6">
      <div class="label-mono text-club-blue">Aktuelle Runde</div>
      <p class="mt-1.5 text-sm leading-relaxed text-muted sm:text-[15px]">{hinweis}</p>
    </section>

    <section class="space-y-4 sm:hidden">
      {runden.map((runde) => {
        const gespielt = runde.matches.filter(isPlayed).length;
        const isAktuell = runde.name === aktuelleRunde;
        return (
          <section class="overflow-hidden rounded-sm border border-deep-ink/10 bg-white/60 shadow-[0_10px_34px_-30px_rgba(26,31,46,0.55)] backdrop-blur-sm">
            <header class="flex items-baseline justify-between gap-3 border-b border-deep-ink/10 bg-warm-sand-2/40 px-3.5 py-3.5">
              <div>
                <div class="label-mono text-club-blue">{runde.name}</div>
                <div class="mt-0.5 font-mono text-[11px] text-muted-2">
                  {runde.matches.length} Matches · {gespielt} gespielt{isAktuell ? ' · im Mai zu spielen' : ''}
                </div>
              </div>
              <div class="label-mono text-court-red">{konkurrenzLabel}</div>
            </header>
            <div class="divide-y divide-deep-ink/8">
              {runde.matches.map((match) => {
                const status = matchStatus(match);
                const result = formatResult(match);
                return (
                  <article class="px-3.5 py-3.5">
                    <div class="flex items-center justify-between gap-3">
                      <div class="font-mono text-[11px] tabular-nums text-muted-2">Match {String(match.nr).padStart(2, '0')}</div>
                      <div class="label-mono text-muted-2">{status === 'gespielt' ? 'Ergebnis' : status === 'terminiert' ? 'Termin' : 'offen'}</div>
                    </div>
                    <div class="mt-2 space-y-2">
                      <div class={`rounded-sm border px-3 py-2 ${match.sieger === 'A' ? 'border-deep-ink/20 bg-warm-sand-2/55 font-semibold text-deep-ink' : 'border-deep-ink/10 bg-white/65 text-deep-ink'}`}>
                        {match.teamA ?? 'TBD'}
                      </div>
                      <div class="px-1 font-mono text-[10px] uppercase tracking-[0.22em] text-muted-2">vs</div>
                      <div class={`rounded-sm border px-3 py-2 ${match.sieger === 'B' ? 'border-deep-ink/20 bg-warm-sand-2/55 font-semibold text-deep-ink' : 'border-deep-ink/10 bg-white/65 text-deep-ink'}`}>
                        {match.teamB ?? 'TBD'}
                      </div>
                    </div>
                    <div class="mt-2 font-mono text-[11px] text-muted-2">
                      {status === 'gespielt' ? result : match.termin ? `Termin · ${match.termin}` : 'Noch offen'}
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        );
      })}
    </section>

    <section class="hidden sm:block">
      <div class="overflow-x-auto pb-4">
        <div class="bracket min-w-[1260px]">
          {runden.map((runde, roundIndex) => {
            const gespielt = runde.matches.filter(isPlayed).length;
            const isAktuell = runde.name === aktuelleRunde;
            const topSpacing = roundIndex === 0 ? 0 : 84 * (2 ** (roundIndex - 1));
            const matchGap = 28 + 92 * (2 ** roundIndex);
            return (
              <section class="bracket-round">
                <header class="mb-5 px-1">
                  <div class="label-mono text-club-blue">{runde.name}</div>
                  <div class="mt-1 font-mono text-[11px] text-muted-2">
                    {runde.matches.length} Matches · {gespielt} gespielt{isAktuell ? ' · im Mai zu spielen' : ''}
                  </div>
                </header>

                <div class="bracket-lane" style={`padding-top:${topSpacing}px; gap:${matchGap}px;`}>
                  {runde.matches.map((match) => {
                    const status = matchStatus(match);
                    const result = formatResult(match);
                    return (
                      <article class="bracket-match">
                        <div class="bracket-match-meta">
                          <span>Match {String(match.nr).padStart(2, '0')}</span>
                          <span>{status === 'gespielt' ? result : match.termin ? match.termin : 'offen'}</span>
                        </div>
                        <div class={`bracket-team ${match.sieger === 'A' ? 'is-winner' : ''}`}>{match.teamA ?? 'TBD'}</div>
                        <div class="bracket-team-divider" aria-hidden="true"></div>
                        <div class={`bracket-team ${match.sieger === 'B' ? 'is-winner' : ''}`}>{match.teamB ?? 'TBD'}</div>
                      </article>
                    );
                  })}
                </div>
              </section>
            );
          })}
        </div>
      </div>
    </section>

  <style>
    .bracket {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(270px, 1fr);
      gap: 2rem;
      align-items: start;
    }

    .bracket-round {
      position: relative;
    }

    .bracket-lane {
      position: relative;
      display: flex;
      flex-direction: column;
    }

    .bracket-match {
      position: relative;
      min-height: 122px;
      border: 1px solid rgba(26, 31, 46, 0.12);
      background: rgba(255, 255, 255, 0.88);
      box-shadow: 0 16px 40px -34px rgba(26, 31, 46, 0.7);
      backdrop-filter: blur(10px);
    }

    .bracket-match::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -2rem;
      width: 2rem;
      border-top: 1.5px solid rgba(26, 31, 46, 0.22);
    }

    .bracket-round:last-child .bracket-match::after {
      display: none;
    }

    .bracket-match-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      border-bottom: 1px solid rgba(26, 31, 46, 0.08);
      padding: 0.65rem 0.85rem;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-muted-2);
    }

    .bracket-team {
      position: relative;
      padding: 0.9rem 1rem;
      font-size: 0.95rem;
      line-height: 1.3rem;
      color: var(--color-deep-ink);
      background: rgba(255, 255, 255, 0.96);
    }

    .bracket-team.is-winner {
      background: rgba(246, 241, 233, 0.95);
      font-weight: 600;
    }

    .bracket-team-divider {
      border-top: 1px solid rgba(26, 31, 46, 0.08);
    }
  </style>
  </div>
)}
