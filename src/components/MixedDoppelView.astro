---
import mixedData from '../data/mixed-doppel.json';
import { getMixedRunden } from '../lib/results';
import KOView from './KOView.astro';

// Metadaten (Überschrift/Hinweis) statisch aus JSON, Runden mit DB-Ergebnissen.
const runden = getMixedRunden();
---

<KOView
  headline={mixedData.headline}
  konkurrenzLabel={mixedData.headline}
  aktuelleRunde={mixedData.aktuelleRunde}
  hinweis={mixedData.hinweis}
  runden={runden}
/>
