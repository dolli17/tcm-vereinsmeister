---
import Layout from '../layouts/Layout.astro';

type Props = { title?: string; heading: string; sub?: string; back?: { href: string; label: string } };
const { title, heading, sub, back } = Astro.props;
---

<Layout title={title}>
  <div class="app plain">
    <div class="scroll">
      <div style="display:flex;justify-content:center;padding:26px 18px 6px">
        <img class="brand-logo" style="height:54px" src="/tcm-logo.png" alt="TC Muckensturm" />
      </div>
      <div class="auth-wrap" style="max-width:460px;margin:0 auto">
        {back && <a href={back.href} class="backbar" style="border:none;padding:6px 0 14px;display:inline-flex">{back.label}</a>}
        <h1 class="section-title" style="padding:0 0 4px">{heading}</h1>
        {sub && <p class="section-sub" style="padding:0 0 18px">{sub}</p>}
        <div class="auth-card">
          <slot />
        </div>
      </div>
    </div>
  </div>
</Layout>
