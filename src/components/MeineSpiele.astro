---
import einzelData from '../data/einzel.json';
import damenEinzelData from '../data/damen-einzel.json';
import doppelData from '../data/doppel.json';
import mixedDoppelData from '../data/mixed-doppel.json';
import spielerData from '../data/spieler.json';
import { slugifyPlayer } from '../lib/playerStats';

type EinzelMatch = {
  nr: number;
  gruppe: number;
  monat: string;
  spielerA: string;
  spielerB: string;
  termin: string | null;
  satz1: string | null;
  satz2: string | null;
  mtb: string | null;
  sieger: 'A' | 'B' | null;
};

type DoppelMatch = {
  runde: string;
  nr: number;
  doppelA: string | null;
  doppelB: string | null;
  termin: string | null;
  satz1: string | null;
  satz2: string | null;
  mtb: string | null;
  sieger: 'A' | 'B' | null;
};

type MixedMatch = {
  runde: string;
  nr: number;
  teamA: string | null;
  teamB: string | null;
  termin: string | null;
  satz1: string | null;
  satz2: string | null;
  mtb: string | null;
  sieger: 'A' | 'B' | null;
};

const einzelMatches = [
  ...(einzelData.matches as EinzelMatch[]).map((m) => ({ ...m, art: 'Einzel' as const })),
  ...(damenEinzelData.matches as EinzelMatch[]).map((m) => ({ ...m, art: 'Damen Einzel' as const })),
];
const doppelMatches = doppelData.matches as DoppelMatch[];
// Mixed-Doppel ist als KO-Baum strukturiert (runden[].matches[]); für die Suche
// flachen wir auf eine Match-Liste runter und merken uns den Rundennamen am Match.
const mixedMatches: MixedMatch[] = mixedDoppelData.runden.flatMap((runde) =>
  runde.matches.map((m) => ({
    runde: runde.name,
    nr: m.nr,
    teamA: m.teamA ?? null,
    teamB: m.teamB ?? null,
    termin: m.termin ?? null,
    satz1: m.satz1 ?? null,
    satz2: m.satz2 ?? null,
    mtb: m.mtb ?? null,
    sieger: (m.sieger ?? null) as 'A' | 'B' | null,
  })),
);

function teamPlayers(team: string | null): string[] {
  if (!team || team === 'BYE') return [];
  return team.split('/').map((p) => p.trim());
}

// "Sieger Match 1", "Sieger Viertelfinale 2", … sind Bracket-Platzhalter,
// keine echten Spielernamen — bei der Spielersuche ausblenden.
const isPlaceholder = (name: string) => /^Sieger\s/i.test(name);

const einzelSpieler = (spielerData.einzel as { name: string }[]).map((s) => s.name);
const damenEinzelSpieler = (spielerData.damenEinzel as { name: string }[]).map((s) => s.name);
const doppelSpieler = doppelMatches.flatMap((m) => [...teamPlayers(m.doppelA), ...teamPlayers(m.doppelB)]);
const mixedSpieler = mixedMatches.flatMap((m) => [...teamPlayers(m.teamA), ...teamPlayers(m.teamB)]);
const spielerNamen = Array.from(
  new Set([...einzelSpieler, ...damenEinzelSpieler, ...doppelSpieler, ...mixedSpieler]),
)
  .filter((n) => !isPlaceholder(n))
  .sort((a, b) => a.localeCompare(b, 'de'));
const spielerLinks = spielerNamen.map((name) => ({ name, slug: slugifyPlayer(name) }));
---

<section class="mb-4 sm:mb-6" aria-label="Persönlicher Spielplan">
  <button type="button" class="player-open-button w-full" data-player-open>
    <span>
      <span class="label-mono block text-club-blue">Meine Spiele</span>
      <span class="mt-1 block font-serif text-xl leading-none">Persönlicher Spielplan</span>
      <span class="mt-1.5 block text-sm leading-tight text-muted">Spieler suchen und Matches anzeigen</span>
    </span>
    <span class="player-open-mark" aria-hidden="true"></span>
  </button>
</section>

<dialog class="player-dialog w-[calc(100%-2rem)] max-w-2xl rounded-sm border border-deep-ink/15 bg-warm-sand p-0 text-deep-ink shadow-[0_24px_70px_-36px_rgba(26,31,46,0.45)] backdrop:bg-deep-ink/45" data-player-dialog>
  <div class="border-b border-deep-ink/10 px-4 py-4 sm:px-6">
    <div class="flex items-start justify-between gap-4">
      <div>
        <div class="label-mono text-club-blue">Meine Spiele</div>
        <h2 class="mt-1 font-serif text-2xl leading-tight sm:text-3xl">
          Persönlicher Spielplan
        </h2>
      </div>
      <button type="button" class="player-dialog-close" data-player-close aria-label="Meine Spiele schliessen">
        <span aria-hidden="true">×</span>
      </button>
    </div>
  </div>

  <div class="max-h-[min(74dvh,640px)] overflow-y-auto">
    <div class="px-4 py-4 sm:px-6 sm:py-5">
      <div class="grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
        <label class="block">
          <span class="label-mono mb-1.5 block text-muted-2">Spieler suchen</span>
          <input
            class="player-search"
            type="search"
            list="spieler-suche"
            placeholder="Name eingeben"
            autocomplete="off"
            data-player-search
          />
        </label>
        <button type="button" class="clear-player" data-player-clear>Zurücksetzen</button>
      </div>
      <datalist id="spieler-suche">
        {spielerNamen.map((name) => <option value={name} />)}
      </datalist>
    </div>

    <div class="border-t border-deep-ink/10 px-4 py-4 sm:px-6 sm:py-5" data-player-results>
      <p class="text-sm leading-relaxed text-muted">
        Wähle einen Spieler aus, um alle Einzel-, Doppel- und Mixed-Doppel-Matches dieses Spielers zu sehen.
      </p>
    </div>
  </div>
</dialog>

<script define:vars={{ einzelMatches, doppelMatches, mixedMatches, spielerLinks }}>
  const input = document.querySelector('[data-player-search]');
  const clearBtn = document.querySelector('[data-player-clear]');
  const results = document.querySelector('[data-player-results]');
  const openBtn = document.querySelector('[data-player-open]');
  const closeBtn = document.querySelector('[data-player-close]');
  const dialog = document.querySelector('[data-player-dialog]');

  function teamPlayers(team) {
    if (!team || team === 'BYE') return [];
    return team.split('/').map((p) => p.trim());
  }

  function teamLabel(team) {
    if (!team || team === 'BYE') return 'Freilos';
    return team;
  }

  function statusOf(match, hasOpponent = true) {
    if (!hasOpponent) return 'Freilos';
    if (match.sieger === 'A' || match.sieger === 'B') return 'Gespielt';
    if (match.termin) return 'Terminiert';
    return 'Offen';
  }

  function resultOf(match) {
    return [match.satz1, match.satz2, match.mtb].filter(Boolean).join(' · ');
  }

  function normalize(value) {
    return value.trim().toLocaleLowerCase('de');
  }

  function selectedPlayerLink(query) {
    return spielerLinks.find((player) => normalize(player.name) === query);
  }

  function matchCard(item) {
    const result = item.result ? `<div class="player-result">${item.result}</div>` : '';
    return `
      <article class="player-card">
        <div class="player-card-head">
          <div>
            <div class="label-mono text-club-blue">${item.art}</div>
            <div class="mt-1 font-mono text-[11px] text-muted-2">${item.context} · ${item.number}</div>
          </div>
          <div class="player-status">${item.status}</div>
        </div>
        <div class="mt-3 text-[15px] leading-tight text-deep-ink">${item.playerLine}</div>
        <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-muted-2">${item.detail}</div>
        ${result}
      </article>
    `;
  }

  function render() {
    if (!input || !results) return;
    const query = normalize(input.value);
    if (!query) {
      results.innerHTML = '<p class="text-sm leading-relaxed text-muted">Wähle einen Spieler aus, um alle Einzel-, Doppel- und Mixed-Doppel-Matches dieses Spielers zu sehen.</p>';
      return;
    }

    const einzel = einzelMatches
      .filter((m) => normalize(m.spielerA).includes(query) || normalize(m.spielerB).includes(query))
      .map((m) => {
        const selectedIsA = normalize(m.spielerA).includes(query);
        const opponent = selectedIsA ? m.spielerB : m.spielerA;
        return {
          art: m.art,
          context: `Gruppe ${m.gruppe} · ${m.monat}`,
          number: `Match ${String(m.nr).padStart(2, '0')}`,
          playerLine: `${m.spielerA} vs ${m.spielerB}`,
          detail: `Gegner: ${opponent}${m.termin ? ` · Termin: ${m.termin}` : ''}`,
          status: statusOf(m),
          result: resultOf(m),
        };
      });

    function teamMatchCard(art, m, fieldA, fieldB) {
      const teamA = teamPlayers(m[fieldA]);
      const teamB = teamPlayers(m[fieldB]);
      const selectedInA = teamA.some((p) => normalize(p).includes(query));
      const ownTeam = selectedInA ? teamA : teamB;
      const otherTeam = selectedInA ? teamB : teamA;
      const partner = ownTeam.find((p) => !normalize(p).includes(query)) ?? 'ohne Partner';
      const opponent = otherTeam.length > 0 ? otherTeam.join(' / ') : 'Freilos';
      return {
        art,
        context: m.runde,
        number: `Match ${String(m.nr).padStart(2, '0')}`,
        playerLine: `${teamLabel(m[fieldA])} vs ${teamLabel(m[fieldB])}`,
        detail: `Partner: ${partner} · Gegner: ${opponent}${m.termin ? ` · Termin: ${m.termin}` : ''}`,
        status: statusOf(m, otherTeam.length > 0),
        result: resultOf(m),
      };
    }

    const doppel = doppelMatches
      .filter((m) => [...teamPlayers(m.doppelA), ...teamPlayers(m.doppelB)].some((p) => normalize(p).includes(query)))
      .map((m) => teamMatchCard('Doppel', m, 'doppelA', 'doppelB'));

    const mixed = mixedMatches
      .filter((m) => [...teamPlayers(m.teamA), ...teamPlayers(m.teamB)].some((p) => normalize(p).includes(query)))
      .map((m) => teamMatchCard('Mixed Doppel', m, 'teamA', 'teamB'));

    const items = [...einzel, ...doppel, ...mixed];
    if (items.length === 0) {
      results.innerHTML = '<p class="text-sm leading-relaxed text-muted">Keine Matches für diese Suche gefunden.</p>';
      return;
    }

    const playerLink = selectedPlayerLink(query);
    const statsLink = playerLink
      ? `<a class="player-stats-link" href="/spieler/${playerLink.slug}/">Statistik für ${playerLink.name} öffnen</a>`
      : '';

    results.innerHTML = `
      <div class="label-mono mb-3 text-court-red">${items.length} Matches gefunden</div>
      ${statsLink}
      <div class="grid gap-3">${items.map(matchCard).join('')}</div>
    `;
  }

  input?.addEventListener('input', render);
  clearBtn?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    render();
    input.focus();
  });

  function openDialog() {
    if (!dialog?.open) {
      dialog?.showModal();
      requestAnimationFrame(() => dialog?.classList.add('is-open'));
    }
    window.setTimeout(() => input?.focus(), 120);
  }

  function closeDialog() {
    if (!dialog?.open || dialog.classList.contains('is-closing')) return;

    dialog.classList.remove('is-open');
    dialog.classList.add('is-closing');
    window.setTimeout(() => {
      dialog.close();
      dialog.classList.remove('is-closing');
    }, 220);
  }

  openBtn?.addEventListener('click', openDialog);
  closeBtn?.addEventListener('click', closeDialog);
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) closeDialog();
  });
  dialog?.addEventListener('cancel', (event) => {
    event.preventDefault();
    closeDialog();
  });
</script>

<style>
  .player-open-button {
    cursor: pointer;
    display: flex;
    min-height: 62px;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0.9rem 0.85rem 1rem;
    border: 1px solid rgba(26, 31, 46, 0.12);
    border-radius: 4px;
    color: var(--color-deep-ink);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.42)),
      rgba(255, 255, 255, 0.45);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.58),
      0 12px 32px -28px rgba(26, 31, 46, 0.85);
    text-align: left;
    backdrop-filter: blur(10px);
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background-color 0.18s ease,
      box-shadow 0.18s ease;
  }
  .player-open-button:hover {
    border-color: rgba(26, 31, 46, 0.28);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.86), rgba(255, 255, 255, 0.54)),
      rgba(255, 255, 255, 0.62);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      0 18px 38px -30px rgba(26, 31, 46, 0.95);
  }
  .player-open-button:active {
    transform: translateY(1px);
  }

  .player-open-mark {
    position: relative;
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    border: 1px solid rgba(26, 31, 46, 0.2);
    border-radius: 999px;
    background: rgba(26, 139, 199, 0.1);
    transition: transform 0.18s ease, background-color 0.18s ease;
  }
  .player-open-button:hover .player-open-mark {
    background: rgba(26, 139, 199, 0.16);
    transform: translateX(2px);
  }
  .player-open-mark::before,
  .player-open-mark::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 1px;
    background: var(--color-deep-ink);
    content: "";
    transform: translate(-50%, -50%);
  }
  .player-open-mark::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .player-dialog {
    position: fixed;
    top: 50%;
    right: auto;
    bottom: auto;
    left: 50%;
    width: min(calc(100dvw - 2rem), 42rem);
    max-height: min(calc(100dvh - 2rem), 760px);
    margin: 0;
    opacity: 0;
    transform: translate(-50%, calc(-50% + 18px)) scale(0.96);
    transition:
      opacity 0.24s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.24s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  .player-dialog.is-open {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .player-dialog.is-closing {
    opacity: 0;
    transform: translate(-50%, calc(-50% + 10px)) scale(0.98);
  }

  .player-dialog::backdrop {
    opacity: 0;
    backdrop-filter: blur(3px);
    transition: opacity 0.24s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .player-dialog.is-open::backdrop {
    opacity: 1;
  }

  .player-dialog.is-closing::backdrop {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .player-dialog,
    .player-dialog::backdrop {
      transition: none;
      will-change: auto;
    }
  }

  .player-search {
    width: 100%;
    min-height: 46px;
    border: 1px solid rgba(26, 31, 46, 0.16);
    border-radius: 4px;
    padding: 0.7rem 0.85rem;
    color: var(--color-deep-ink);
    background: rgba(255, 255, 255, 0.62);
    font: inherit;
    outline: none;
  }
  .player-search:focus {
    border-color: var(--color-deep-ink);
  }

  .clear-player {
    cursor: pointer;
    min-height: 42px;
    border: 1px solid rgba(26, 31, 46, 0.16);
    border-radius: 4px;
    padding: 0.7rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.2px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-muted);
    background: transparent;
  }
  .clear-player:active {
    transform: translateY(1px);
  }

  .player-dialog-close {
    cursor: pointer;
    display: grid;
    width: 34px;
    height: 34px;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(26, 31, 46, 0.15);
    border-radius: 4px;
    color: var(--color-deep-ink);
    background: transparent;
    font-size: 24px;
    line-height: 1;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }
  .player-dialog-close:hover {
    border-color: var(--color-deep-ink);
  }
  .player-dialog-close:active {
    transform: translateY(1px);
  }

  :global(.player-card) {
    border-left: 2px solid rgba(26, 139, 199, 0.55);
    padding: 0.85rem 0 0.85rem 0.85rem;
  }
  :global(.player-card-head) {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  :global(.player-status) {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.1px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-muted-2);
  }
  :global(.player-result) {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-deep-ink);
  }
  :global(.player-stats-link) {
    display: block;
    margin-bottom: 0.75rem;
    border: 1px solid rgba(26, 31, 46, 0.14);
    border-radius: 4px;
    padding: 0.75rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.1px;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--color-deep-ink);
    background: rgba(255, 255, 255, 0.5);
    text-decoration: none;
  }
</style>
