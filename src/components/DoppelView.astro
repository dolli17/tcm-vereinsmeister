---
import { getDoppelMatches } from '../lib/results';
import KOView from './KOView.astro';

const matches = getDoppelMatches('doppel').map((match) => ({
  nr: match.nr,
  teamA: match.doppelA,
  teamB: match.doppelB,
  termin: match.termin,
  satz1: match.satz1,
  satz2: match.satz2,
  mtb: match.mtb,
  sieger: match.sieger,
}));
---

<KOView
  headline="Herren Doppel"
  konkurrenzLabel="Herren Doppel"
  aktuelleRunde="1. Runde"
  hinweis="Die 1. Runde im Herren Doppel ist im Mai zu spielen. Bitte stimmt eure Termine selbstständig ab und meldet sie vor dem Spiel dem Sportwart."
  runden={[{ name: '1. Runde', matches }]}
/>
