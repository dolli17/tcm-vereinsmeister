---
import AppShell from '../components/AppShell.astro';
import { hasCasualAccess } from '../lib/auth';
import { getActiveSeason, listSeasons } from '../lib/tournament';
import { getAllPlayerNames } from '../lib/playerStats';
import { headToHead, listCasualMatches } from '../lib/casual';

// Doppelte Absicherung zur Middleware.
if (!hasCasualAccess(Astro.locals.user)) return Astro.redirect('/');

const season = getActiveSeason();
const seasons = listSeasons();
const names = getAllPlayerNames();
const params = Astro.url.searchParams;
const a = (params.get('a') ?? '').trim();
const b = (params.get('b') ?? '').trim();
const h2h = a && b && a.toLowerCase() !== b.toLowerCase() ? headToHead(a, b) : null;
const recent = listCasualMatches(100);

const ok = params.get('ok');
const okMsg: Record<string, string> = { added: 'Duell gespeichert.', deleted: 'Duell gelöscht.' };
const err = params.get('error');
const errMsg: Record<string, string> = {
  names: 'Bitte beide Personen mit gültigem Namen angeben.',
  same: 'Bitte zwei verschiedene Personen wählen.',
  score: 'Ergebnis ungültig — mind. ein Satz (z. B. 6:3), eindeutiger Sieger.',
  notowner: 'Nur der Ersteller (oder Admin) kann ein Duell löschen.',
  input: 'Aktion fehlgeschlagen.',
};
const initials = (n: string) => n.split(' ').filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---

<AppShell active="casual" season={season} seasons={seasons} title="Casual · Head-to-Head">
  <div class="section-title">Casual &amp; Head-to-Head</div>
  <div class="section-sub">Lockere Duelle außerhalb der Vereinsmeisterschaft — inklusive der bestätigten VM-Duelle.</div>

  <div class="section">
    {ok && okMsg[ok] && <div class="notice ok">{okMsg[ok]}</div>}
    {err && errMsg[err] && <div class="notice err">{errMsg[err]}</div>}

    <datalist id="casual-spieler">{names.map((n) => <option value={n} />)}</datalist>

    <!-- Head-to-Head -->
    <div class="card" style="padding:16px">
      <h2 class="section-title" style="padding:0 0 10px;font-size:1.3rem">Head-to-Head</h2>
      <form method="GET" style="display:grid;gap:10px">
        <label class="field" style="margin:0"><span class="lbl">Person A</span><input class="input" name="a" list="casual-spieler" value={a} placeholder="Name" autocomplete="off" /></label>
        <label class="field" style="margin:0"><span class="lbl">Person B</span><input class="input" name="b" list="casual-spieler" value={b} placeholder="Name" autocomplete="off" /></label>
        <button class="btn block">Vergleichen</button>
      </form>

      {h2h && (
        <div style="margin-top:16px;border-top:1px solid var(--line);padding-top:18px">
          <div style="display:grid;grid-template-columns:1fr auto 1fr;align-items:start;gap:8px;text-align:center">
            <div style="display:flex;flex-direction:column;align-items:center;gap:7px;min-width:0">
              <span class="avatar" style="width:48px;height:48px;font-size:1.05rem">{initials(h2h.a)}</span>
              <span style="font-family:var(--font-head);font-weight:700;font-size:.95rem;line-height:1.15">{h2h.a}</span>
            </div>
            <div style="padding-top:6px">
              <div style="font-family:var(--font-head);font-weight:700;font-size:2.3rem;line-height:1">{h2h.aWins}<span style="color:var(--muted);padding:0 6px">:</span>{h2h.bWins}</div>
              <div style="font-size:.66rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-top:5px;background:var(--chip);border-radius:99px;padding:3px 9px;display:inline-block">{h2h.total} Duelle</div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:center;gap:7px;min-width:0">
              <span class="avatar" style="width:48px;height:48px;font-size:1.05rem;background:linear-gradient(150deg,var(--gold),#E08A00)">{initials(h2h.b)}</span>
              <span style="font-family:var(--font-head);font-weight:700;font-size:.95rem;line-height:1.15">{h2h.b}</span>
            </div>
          </div>

          {h2h.duels.length === 0 ? (
            <p class="section-sub" style="text-align:center;padding:12px 0 0">Noch keine Duelle erfasst.</p>
          ) : (
            <div style="margin-top:14px;display:flex;flex-direction:column;gap:7px">
              {h2h.duels.map((d) => (
                <div class="rrow" style="border:1px solid var(--line);border-radius:12px;padding:9px 11px">
                  <span class={`status-tag ${d.kind === 'VM' ? 'open' : 'done'}`} style="flex-shrink:0">{d.kind}</span>
                  <div class="ri">Sieger: {d.winner}<small>{d.context}{d.datum ? ` · ${d.datum}` : ''}</small></div>
                  {d.result && <span class="rs">{d.result}</span>}
                </div>
              ))}
            </div>
          )}
        </div>
      )}
    </div>

    <!-- Duell erfassen -->
    <div class="card" style="padding:16px;margin-top:14px">
      <h2 class="section-title" style="padding:0 0 10px;font-size:1.3rem">Duell erfassen</h2>
      <form method="POST" action="/api/casual/match" style="display:grid;gap:10px">
        <input type="hidden" name="action" value="add" />
        <div style="display:grid;gap:10px;grid-template-columns:1fr 1fr">
          <label class="field" style="margin:0"><span class="lbl">Person A</span><input class="input" name="player_a" list="casual-spieler" required placeholder="Name" autocomplete="off" /></label>
          <label class="field" style="margin:0"><span class="lbl">Person B</span><input class="input" name="player_b" list="casual-spieler" required placeholder="Name" autocomplete="off" /></label>
        </div>
        <div style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap">
          <label class="field" style="margin:0"><span class="lbl">Datum</span><input class="input" style="min-width:9rem" type="date" name="datum" /></label>
          <label class="field" style="margin:0"><span class="lbl">Satz 1</span><input class="score-in" name="satz1" required placeholder="6:3" /></label>
          <label class="field" style="margin:0"><span class="lbl">Satz 2</span><input class="score-in" name="satz2" placeholder="4:6" /></label>
          <label class="field" style="margin:0"><span class="lbl">MTB</span><input class="score-in" name="mtb" placeholder="10:7" /></label>
        </div>
        <label class="field" style="margin:0"><span class="lbl">Notiz (optional)</span><input class="input" name="notiz" placeholder="z. B. Sandplatz, Abend" /></label>
        <button class="btn">Duell speichern</button>
        <p class="section-sub" style="padding:0">Sieger wird aus den Sätzen ermittelt. Person A steht links (Satz aus A-Sicht: 6:3 = A führt).</p>
      </form>
    </div>

    <!-- Erfasste Duelle -->
    <h2 class="section-title" style="padding:14px 0 6px;font-size:1.3rem">Erfasste Duelle <span style="color:var(--muted)">({recent.length})</span></h2>
    {recent.length === 0 ? (
      <div class="empty"><div class="t">Noch keine Casual-Duelle</div><div class="d">Erfasse oben das erste Duell.</div></div>
    ) : (
      <div style="display:flex;flex-direction:column;gap:9px">
        {recent.map((m) => (
          <div class="feedrow">
            <span class="avatar" style="width:34px;height:34px;font-size:.78rem">{initials(m.sieger === 'A' ? m.player_a : m.player_b)}</span>
            <div class="info">
              <div class="who"><b>{m.sieger === 'A' ? m.player_a : m.player_b}</b> <span class="beat">schlägt</span> {m.sieger === 'A' ? m.player_b : m.player_a}</div>
              <div class="sub">{m.datum ? <span class="cat">{m.datum}</span> : null}{m.notiz ? ` · ${m.notiz}` : ''}</div>
            </div>
            <div class="setchips">{[m.satz1, m.satz2, m.mtb].filter(Boolean).map((s) => <i>{s}</i>)}</div>
            {(Astro.locals.user?.role === 'admin' || m.created_by === Astro.locals.user?.id) && (
              <form method="POST" action="/api/casual/match">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={m.id} />
                <button class="btn sm danger" type="submit">✕</button>
              </form>
            )}
          </div>
        ))}
      </div>
    )}
  </div>
</AppShell>
