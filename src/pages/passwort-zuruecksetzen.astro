---
import AuthShell from '../components/AuthShell.astro';

const params = Astro.url.searchParams;
const token = params.get('token') ?? '';
const error = params.get('error');
const errorMsg =
  error === 'token' ? 'Der Reset-Link ist ungültig oder abgelaufen. Bitte fordere einen neuen an.' :
  error === 'pwlen' ? 'Das Passwort muss mindestens 8 Zeichen haben.' :
  error === 'pwmatch' ? 'Die Passwörter stimmen nicht überein.' :
  null;
const noToken = !token;
---

<AuthShell title="Passwort zurücksetzen · Vereinsmeisterschaft" heading="Neues Passwort" back={{ href: '/login', label: '← Zur Anmeldung' }}>
  {errorMsg && <div class="notice err">{errorMsg}</div>}

  {noToken ? (
    <p style="font-size:.95rem;color:var(--muted)">Kein gültiger Link. <a href="/passwort-vergessen" style="color:var(--accent);font-weight:700">Reset-Link erneut anfordern</a>.</p>
  ) : (
    <form method="POST" action="/api/auth/reset">
      <input type="hidden" name="token" value={token} />
      <label class="field"><span class="lbl">Neues Passwort (min. 8 Zeichen)</span><input class="input" type="password" name="password" required minlength="8" autocomplete="new-password" /></label>
      <label class="field"><span class="lbl">Passwort wiederholen</span><input class="input" type="password" name="password2" required minlength="8" autocomplete="new-password" /></label>
      <button type="submit" class="btn block">Passwort speichern</button>
    </form>
  )}
</AuthShell>
