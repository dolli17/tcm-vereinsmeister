---
import AppShell from '../components/AppShell.astro';
import HomePersonal from '../components/HomePersonal.astro';
import HomeFeed from '../components/HomeFeed.astro';
import { getActiveSeason, getCompetitions, getEnrichedMatches, isPlayed, listSeasons, teamPlayers } from '../lib/tournament';
import { getActivityFeed, getUpcomingMatches } from '../lib/feed';
import { getPlayerMatches } from '../lib/matchEntry';
import { formatTermin, getPendingProposals, type TerminProposal } from '../lib/termine';
import { getPhoneMap } from '../lib/players';

// Alte Links/Lesezeichen: /?saison=… zeigte früher die Wettbewerbs-Ansicht.
const saisonParam = Astro.url.searchParams.get('saison');
if (saisonParam) return Astro.redirect(`/konkurrenzen?saison=${encodeURIComponent(saisonParam)}`);

const user = Astro.locals.user;
const season = getActiveSeason();
const seasons = listSeasons();

// Saison-Fortschritt (Freilose/Platzhalter ausgenommen) — wie auf /konkurrenzen.
let done = 0, total = 0;
if (season) {
  for (const comp of getCompetitions(season.id)) {
    for (const m of getEnrichedMatches(comp.id)) {
      if (teamPlayers(m.sideA).length === 0 || teamPlayers(m.sideB).length === 0) continue;
      total++; if (isPlayed(m)) done++;
    }
  }
}

const feed = season ? getActivityFeed(season.id) : [];
const upcoming = season ? getUpcomingMatches(season.id) : [];

// Persönlicher Bereich nur mit freigegebenem Spielernamen.
const approved = !!user?.player_name && user.claim_status === 'approved';
const playerMatches = approved && user?.player_name ? getPlayerMatches(user.player_name, user.id) : [];
const proposals: Map<number, TerminProposal> = approved ? getPendingProposals() : new Map();
const phone = approved ? getPhoneMap() : {};
const pct = total > 0 ? Math.round((done / total) * 100) : 0;
---

<AppShell active="home" season={season} seasons={seasons} title="Start · Vereinsmeisterschaft">
  <div class="section" style="padding-top:18px">
    {approved && user && season ? (
      <HomePersonal matches={playerMatches} proposals={proposals} userId={user.id} seasonJahr={season.jahr} phone={phone} />
    ) : (
      <div class="card fade-in home-hero">
        <div class="hero-title">🎾 {season ? season.name : 'Vereinsmeisterschaft'}</div>
        {total > 0 && (
          <div class="hero-progress">
            <div class="progress-track"><div class="progress-fill" style={`width:${pct}%`}></div></div>
            <span class="hero-progress-label"><b>{done}</b> von {total} Partien gespielt</span>
          </div>
        )}
        {user ? (
          <p class="hero-sub">{user.player_name ? `Dein Namensanspruch „${user.player_name}" wartet auf Freigabe — danach erscheinen hier deine Spiele.` : 'Hinterlege in den Einstellungen deinen Spielernamen, um deine Spiele hier zu sehen.'}</p>
        ) : (
          <>
            <p class="hero-sub">Melde dich an, um deine Spiele, Termine und offenen Aktionen direkt hier zu sehen.</p>
            <div class="hero-actions">
              <a href="/login" class="btn">Anmelden</a>
              <a href="/registrieren" class="btn ghost">Account erstellen</a>
            </div>
          </>
        )}
      </div>
    )}

    {upcoming.length > 0 && (
      <div class="card fade-in" style="margin-bottom:18px">
        <div class="card-head"><span class="ttl">Demnächst auf dem Platz</span><span class="ct">{upcoming.length}</span></div>
        <div>
          {upcoming.map((u) => (
            <div class="feed-row">
              <span class="feed-ic">📅</span>
              <span class="feed-text">
                <b>{u.sideA}</b> vs <b>{u.sideB}</b>
                <span class="feed-meta">{u.comp} · {formatTermin(u.termin)}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    )}

    <HomeFeed entries={feed} />

    <p class="section-sub" style="text-align:center;padding:6px 0 14px;display:flex;gap:18px;justify-content:center;flex-wrap:wrap">
      <a href="/konkurrenzen" style="color:var(--accent);font-weight:700;text-decoration:none">🏆 Tabellen &amp; Spielpläne</a>
      <a href="/rangliste" style="color:var(--accent);font-weight:700;text-decoration:none">📈 Ewige Rangliste</a>
      {seasons.some((s) => s.status === 'archiviert') && (
        <a href="/archiv" style="color:var(--accent);font-weight:700;text-decoration:none">🥇 Saison-Archiv</a>
      )}
    </p>
  </div>
</AppShell>
