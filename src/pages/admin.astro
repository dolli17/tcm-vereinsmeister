---
import AdminShell from '../components/AdminShell.astro';
import { getDb } from '../lib/db';
import { getActiveSeason, getCompetitions, getEnrichedMatches, isPlayed, teamPlayers } from '../lib/tournament';
import { getOverdueMatches, findFixtureById, type OverdueMatch } from '../lib/matchEntry';
import { listAuditLog } from '../lib/audit';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
if (user.role !== 'admin') return Astro.redirect('/');

const db = getDb();
const season = getActiveSeason();

const claims = db
  .prepare("SELECT id, email, player_name, created_at FROM users WHERE claim_status = 'pending' AND player_name IS NOT NULL ORDER BY created_at")
  .all() as { id: number; email: string; player_name: string; created_at: string }[];

type ResRow = {
  id: number; match_id: number | null;
  satz1: string; satz2: string; mtb: string | null; sieger: 'A' | 'B'; reject_reason: string | null;
  submitter: string | null; created_at: string;
};
const loadResults = (status: string) =>
  db
    .prepare(
      `SELECT r.id, r.match_id, r.satz1, r.satz2, r.mtb, r.sieger, r.reject_reason,
              u.player_name AS submitter, r.created_at
       FROM results r
       LEFT JOIN users u ON u.id = r.submitted_by
       JOIN matches m ON m.id = r.match_id
       JOIN competitions c ON c.id = m.competition_id
       WHERE r.status = ? AND c.season_id = ? ORDER BY r.created_at DESC`,
    )
    .all(status, season?.id ?? -1) as ResRow[];

const pending = loadResults('pending');
const rejected = loadResults('rejected');

const accounts = db
  .prepare('SELECT id, email, player_name, role, claim_status, casual_access, created_at FROM users ORDER BY created_at')
  .all() as { id: number; email: string; player_name: string | null; role: string; claim_status: string; casual_access: number; created_at: string }[];

const stats = season
  ? getCompetitions(season.id).map((c) => {
      const ms = getEnrichedMatches(c.id).filter((m) => teamPlayers(m.sideA).length > 0 && teamPlayers(m.sideB).length > 0);
      return { label: c.name, g: ms.filter(isPlayed).length, t: ms.length };
    })
  : [];

const overdueGroups: { label: string; items: OverdueMatch[] }[] = [];
for (const m of getOverdueMatches()) {
  let g = overdueGroups.find((x) => x.label === m.wettbewerbLabel);
  if (!g) { g = { label: m.wettbewerbLabel, items: [] }; overdueGroups.push(g); }
  g.items.push(m);
}
const overdueCount = overdueGroups.reduce((n, g) => n + g.items.length, 0);

function describe(r: ResRow) {
  const fx = r.match_id != null ? findFixtureById(r.match_id) : null;
  const label = fx?.wettbewerbLabel ?? '';
  const ctx = fx ? (fx.runde ?? (fx.gruppe != null ? `Gruppe ${fx.gruppe}` : '')) : '';
  const nr = fx?.nr ?? 0;
  const title = fx ? `${fx.sideA.join(' / ')} vs ${fx.sideB.join(' / ')}` : 'Match';
  const winner = fx ? (r.sieger === 'A' ? fx.sideA : fx.sideB).join(' / ') : `Seite ${r.sieger}`;
  return { label, ctx, nr, title, winner, result: [r.satz1, r.satz2, r.mtb].filter(Boolean).join(' · ') };
}

const params = Astro.url.searchParams;
const ok = params.get('ok');
const okMsg =
  ok === 'claim' ? 'Namensanspruch bearbeitet.' :
  ok === 'confirmed' ? 'Ergebnis bestätigt.' :
  ok === 'deleted' ? 'Ergebnis gelöscht.' :
  ok === 'userdeleted' ? 'Account gelöscht.' :
  ok === 'casual' ? 'Casual-Zugriff geändert.' :
  ok === 'role' ? 'Admin-Rolle geändert.' :
  ok === 'reminded' ? `Erinnerungen versendet (${params.get('n') ?? '0'} Mails).` : null;
const err = params.get('error');
const errMsg =
  err === 'conflict' ? 'Es liegt bereits ein bestätigtes Ergebnis für dieses Spiel vor.' :
  err === 'score' ? 'Das eingegebene Ergebnis ist ungültig (z. B. 6:3 / 6:4, bei 1:1 ein Match-Tiebreak).' :
  err === 'self' ? 'Du kannst deinen eigenen Account nicht löschen.' :
  err ? 'Aktion fehlgeschlagen.' : null;

const audit = listAuditLog(30);
const auditLabel: Record<string, string> = {
  ergebnis_bestaetigt: 'Ergebnis bestätigt', ergebnis_korrigiert: 'Ergebnis korrigiert', ergebnis_geloescht: 'Ergebnis gelöscht',
  ergebnis_eingetragen: 'Ergebnis eingetragen', ergebnis_angenommen: 'Ergebnis angenommen', ergebnis_abgelehnt: 'Ergebnis abgelehnt',
  account_geloescht: 'Account gelöscht', rolle_umgeschaltet: 'Rolle geändert', casual_umgeschaltet: 'Casual geändert',
  name_freigegeben: 'Name freigegeben', name_gesperrt: 'Name gesperrt', spieler_umbenannt: 'Spieler umbenannt',
  saison_angelegt: 'Saison angelegt', saison_aktiviert: 'Saison aktiviert', saison_archiviert: 'Saison archiviert',
  konkurrenz_angelegt: 'Konkurrenz angelegt', konkurrenz_geloescht: 'Konkurrenz gelöscht',
  spielplan_generiert: 'Spielplan generiert', paarung_geloescht: 'Paarung gelöscht',
};

const statusLabel: Record<string, string> = { approved: 'freigegeben', pending: 'wartet', rejected: 'gesperrt' };
const pillCls: Record<string, string> = { approved: 'ok', pending: 'wait', rejected: 'blocked' };
const fmtDate = (s: string) => s.slice(8, 10) + '.' + s.slice(5, 7) + '. ' + s.slice(11, 16);
---

<AdminShell title="Admin · Dashboard" active="dashboard">
  <h1 class="admin-h1">Dashboard</h1>
  <p style="color:var(--muted);margin-bottom:18px">{season ? `Aktive Saison: ${season.name}` : 'Keine aktive Saison'}</p>

  {okMsg && <div class="notice ok">{okMsg}</div>}
  {errMsg && <div class="notice err">{errMsg}</div>}

  <div class="statrow">
    <div class="statbox"><div class="v">{accounts.length}</div><div class="l">Accounts</div></div>
    <div class="statbox"><div class="v">{pending.length}</div><div class="l">offene Bestätigungen</div></div>
    <div class="statbox"><div class={`v ${rejected.length ? 'alert' : ''}`}>{rejected.length}</div><div class="l">zu klären</div></div>
    <div class="statbox"><div class={`v ${overdueCount ? 'alert' : ''}`}>{overdueCount}</div><div class="l">überfällige Spiele</div></div>
    <div class="statbox"><div class="v">{claims.length}</div><div class="l">Namensansprüche</div></div>
  </div>

  <div class="admin-cols">
    <!-- Linke Spalte: zu erledigende Vorgänge -->
    <div>
      <div class="panel">
        <h2>Zu klären <span class="ct">{rejected.length}</span></h2>
        <p style="font-size:.85rem;color:var(--muted);margin-bottom:10px">Abgelehnte Partien gehen nicht zurück an die Spieler. Richtiges Ergebnis eintragen und final bestätigen.</p>
        {rejected.length === 0 ? <p style="color:var(--muted)">Nichts zu klären.</p> : (
          <div>{rejected.map((r) => { const d = describe(r); return (
            <div class="row-item" style="border-color:color-mix(in srgb,var(--danger) 35%,var(--line))">
              <div class="grow">
                <div style="font-family:var(--font-mono);font-size:.72rem;color:var(--danger)">{d.label} · {d.ctx} · #{String(d.nr).padStart(2, '0')}</div>
                <div style="font-weight:600">{d.title}</div>
                <div style="font-size:.8rem;color:var(--muted)">von {r.submitter ?? '–'}: <span style="font-family:var(--font-mono)">{d.result}</span> (Sieger {d.winner}){r.reject_reason ? ` · Grund: ${r.reject_reason}` : ''}</div>
              </div>
              <form method="POST" action="/api/admin/result" style="display:flex;gap:6px;align-items:flex-end">
                <input type="hidden" name="result_id" value={r.id} />
                <input type="hidden" name="action" value="resolve" />
                <input class="score-in" name="satz1" value={r.satz1} required placeholder="6:3" />
                <input class="score-in" name="satz2" value={r.satz2} required placeholder="6:4" />
                <input class="score-in" name="mtb" value={r.mtb ?? ''} placeholder="MTB" />
                <button class="btn sm lime">Eintragen &amp; bestätigen</button>
              </form>
            </div>
          )})}</div>
        )}
      </div>

      <div class="panel">
        <h2>Offene Bestätigungen <span class="ct">{pending.length}</span></h2>
        {pending.length === 0 ? <p style="color:var(--muted)">Keine ausstehenden Ergebnisse.</p> : (
          <div>{pending.map((r) => { const d = describe(r); return (
            <div class="row-item">
              <div class="grow">
                <div style="font-family:var(--font-mono);font-size:.72rem;color:var(--accent)">{d.label} · {d.ctx} · #{String(d.nr).padStart(2, '0')}</div>
                <div style="font-weight:600">{d.title} <span style="font-family:var(--font-mono);color:var(--muted)">· {d.result} · Sieger {d.winner}</span></div>
                <div style="font-size:.8rem;color:var(--muted)">eingetragen von {r.submitter ?? '–'}</div>
              </div>
              <div class="row-actions">
                <form method="POST" action="/api/admin/result"><input type="hidden" name="result_id" value={r.id} /><input type="hidden" name="action" value="confirm" /><button class="btn sm lime">Bestätigen</button></form>
                <form method="POST" action="/api/admin/result"><input type="hidden" name="result_id" value={r.id} /><input type="hidden" name="action" value="delete" /><button class="btn sm danger">Löschen</button></form>
              </div>
            </div>
          )})}</div>
        )}
      </div>

      <div class="panel">
        <h2>Namensansprüche <span class="ct">{claims.length}</span></h2>
        {claims.length === 0 ? <p style="color:var(--muted)">Keine offenen Ansprüche.</p> : (
          <div>{claims.map((c) => (
            <div class="row-item">
              <div class="grow"><div style="font-weight:600">{c.player_name}</div><div style="font-family:var(--font-mono);font-size:.78rem;color:var(--muted)">{c.email}</div></div>
              <div class="row-actions">
                <form method="POST" action="/api/admin/claim"><input type="hidden" name="user_id" value={c.id} /><input type="hidden" name="decision" value="approve" /><button class="btn sm lime">Freigeben</button></form>
                <form method="POST" action="/api/admin/claim"><input type="hidden" name="user_id" value={c.id} /><input type="hidden" name="decision" value="reject" /><button class="btn sm danger">Ablehnen</button></form>
              </div>
            </div>
          ))}</div>
        )}
      </div>
    </div>

    <!-- Rechte Spalte: Status & Schnellzugriff -->
    <div>
      <div class="panel">
        <h2>Schnellzugriff</h2>
        <div style="display:flex;flex-direction:column;gap:8px">
          <a href="/admin/spiele" class="btn block">Spiele &amp; Ergebnisse verwalten</a>
          <a href="/admin/saison" class="btn block ghost">Saisons &amp; Konkurrenzen</a>
          <a href="/admin/spieler" class="btn block ghost">Spielerstamm pflegen</a>
          <form method="POST" action="/api/admin/reminders" onsubmit="return confirm('Erinnerungs-Mails für alle offenen, fälligen Spiele jetzt senden?')">
            <button class="btn block lime">Erinnerungen jetzt senden</button>
          </form>
          <a href="/api/admin/export" class="btn block ghost">Ergebnisse als CSV exportieren</a>
        </div>
      </div>

      <div class="panel">
        <h2>Fortschritt je Konkurrenz</h2>
        {stats.length === 0 ? <p style="color:var(--muted)">Keine Konkurrenzen.</p> : (
          <table class="adm-table">
            <tbody>{stats.map((s) => (
              <tr><td>{s.label}</td><td style="text-align:right;font-family:var(--font-mono)">{s.g}/{s.t}</td></tr>
            ))}</tbody>
          </table>
        )}
      </div>

      <div class="panel">
        <h2>Überfällige Spiele <span class={`ct ${overdueCount ? '' : ''}`}>{overdueCount}</span></h2>
        {overdueCount === 0 ? <p style="color:var(--muted)">Keine überfälligen Spiele 🎾</p> : (
          <div>{overdueGroups.map((g) => (
            <div style="margin-bottom:10px">
              <div style="font-family:var(--font-mono);font-size:.72rem;color:var(--danger);margin-bottom:4px">{g.label} ({g.items.length})</div>
              {g.items.map((m) => (
                <div style="display:flex;justify-content:space-between;gap:8px;font-size:.85rem;padding:4px 0;border-bottom:1px solid var(--line)">
                  <span>{m.sideA.join(' / ')} <span style="color:var(--muted)">vs</span> {m.sideB.join(' / ')}</span>
                  <span style="font-family:var(--font-mono);color:var(--danger);white-space:nowrap">{m.context} · {m.dueName}</span>
                </div>
              ))}
            </div>
          ))}</div>
        )}
      </div>

      <div class="panel">
        <h2>Protokoll <span class="ct">{audit.length}</span></h2>
        {audit.length === 0 ? <p style="color:var(--muted)">Noch keine Einträge.</p> : (
          <div style="max-height:320px;overflow-y:auto">
            {audit.map((e) => (
              <div style="padding:5px 0;border-bottom:1px solid var(--line);font-size:.8rem">
                <div style="display:flex;justify-content:space-between;gap:8px">
                  <span style="font-weight:600">{auditLabel[e.action] ?? e.action}</span>
                  <span style="font-family:var(--font-mono);font-size:.72rem;color:var(--muted);white-space:nowrap">{fmtDate(e.created_at)}</span>
                </div>
                <div style="color:var(--muted)">{e.detail}{e.user_label ? ` · von ${e.user_label}` : ''}</div>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- Accounts: volle Breite -->
  <div class="panel" style="margin-top:16px">
    <h2>Registrierte Accounts <span class="ct">{accounts.length}</span></h2>
    <div style="overflow-x:auto">
      <table class="adm-table">
        <thead><tr><th>E-Mail</th><th>Spieler</th><th>Rolle</th><th>Status</th><th>Casual</th><th>Seit</th><th>Aktionen</th></tr></thead>
        <tbody>
          {accounts.map((a) => (
            <tr>
              <td style="word-break:break-all">{a.email}</td>
              <td>{a.player_name ?? <span style="color:var(--muted)">–</span>}</td>
              <td>{a.role === 'admin' ? <b style="color:var(--accent)">Admin</b> : 'Spieler'}</td>
              <td><span class={`pill ${pillCls[a.claim_status] ?? ''}`}>{statusLabel[a.claim_status] ?? a.claim_status}</span></td>
              <td>{a.casual_access ? <span class="pill ok">an</span> : <span style="color:var(--muted)">–</span>}</td>
              <td style="white-space:nowrap;font-family:var(--font-mono);font-size:.78rem;color:var(--muted)">{fmtDate(a.created_at)}</td>
              <td>
                {a.id === user.id ? <span style="color:var(--muted)">(du)</span> : (
                  <div class="row-actions">
                    {a.claim_status !== 'approved' && a.player_name && (
                      <form method="POST" action="/api/admin/claim"><input type="hidden" name="user_id" value={a.id} /><input type="hidden" name="decision" value="approve" /><button class="btn sm lime">Freigeben</button></form>
                    )}
                    {a.claim_status === 'approved' && (
                      <form method="POST" action="/api/admin/claim"><input type="hidden" name="user_id" value={a.id} /><input type="hidden" name="decision" value="reject" /><button class="btn sm danger">Sperren</button></form>
                    )}
                    <form method="POST" action="/api/admin/user"><input type="hidden" name="user_id" value={a.id} /><input type="hidden" name="action" value="casual" /><button class={`btn sm ${a.casual_access ? 'lime' : 'ghost'}`}>Casual {a.casual_access ? 'an' : 'aus'}</button></form>
                    <form method="POST" action="/api/admin/user" onsubmit={`return confirm('${a.role === 'admin' ? 'Adminrechte entziehen?' : 'Diesen Account zum Admin machen?'}')`}><input type="hidden" name="user_id" value={a.id} /><input type="hidden" name="action" value="role" /><button class={`btn sm ${a.role === 'admin' ? 'ghost' : ''}`}>{a.role === 'admin' ? 'Admin entz.' : 'Zum Admin'}</button></form>
                    <form method="POST" action="/api/admin/user" onsubmit="return confirm('Diesen Account wirklich löschen?')"><input type="hidden" name="user_id" value={a.id} /><input type="hidden" name="action" value="delete" /><button class="btn sm ghost">Löschen</button></form>
                  </div>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminShell>
