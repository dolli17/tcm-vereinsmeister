---
import Layout from '../layouts/Layout.astro';
import { getDb } from '../lib/db';
import { findFixture, type Wettbewerb } from '../lib/fixtures';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
if (user.role !== 'admin') return Astro.redirect('/');

const db = getDb();

const claims = db
  .prepare("SELECT id, email, player_name, created_at FROM users WHERE claim_status = 'pending' AND player_name IS NOT NULL ORDER BY created_at")
  .all() as { id: number; email: string; player_name: string; created_at: string }[];

type ResRow = {
  id: number; wettbewerb: string; gruppe: number | null; runde: string | null; match_nr: number;
  satz1: string; satz2: string; mtb: string | null; sieger: 'A' | 'B'; reject_reason: string | null;
  submitter: string | null; created_at: string;
};
const loadResults = (status: string) =>
  db
    .prepare(
      `SELECT r.id, r.wettbewerb, r.gruppe, r.runde, r.match_nr, r.satz1, r.satz2, r.mtb, r.sieger, r.reject_reason,
              u.player_name AS submitter, r.created_at
       FROM results r LEFT JOIN users u ON u.id = r.submitted_by
       WHERE r.status = ? ORDER BY r.created_at DESC`,
    )
    .all(status) as ResRow[];

const pending = loadResults('pending');
const rejected = loadResults('rejected');

// Alle registrierten Accounts.
const accounts = db
  .prepare('SELECT id, email, player_name, role, claim_status, created_at FROM users ORDER BY created_at')
  .all() as { id: number; email: string; player_name: string | null; role: string; claim_status: string; created_at: string }[];

function describe(r: ResRow) {
  const fx = findFixture(r.wettbewerb as Wettbewerb, { gruppe: r.gruppe, runde: r.runde, nr: r.match_nr });
  const ctx = r.runde ?? (r.gruppe != null ? `Gruppe ${r.gruppe}` : '');
  const title = fx ? `${fx.sideA.join(' / ')} vs ${fx.sideB.join(' / ')}` : `Match ${r.match_nr}`;
  const winner = fx ? (r.sieger === 'A' ? fx.sideA : fx.sideB).join(' / ') : `Seite ${r.sieger}`;
  return { title, ctx, winner, result: [r.satz1, r.satz2, r.mtb].filter(Boolean).join(' · ') };
}

const params = Astro.url.searchParams;
const ok = params.get('ok');
const okMsg =
  ok === 'claim' ? 'Namensanspruch bearbeitet.' :
  ok === 'confirmed' ? 'Ergebnis bestätigt.' :
  ok === 'deleted' ? 'Ergebnis gelöscht.' :
  ok === 'userdeleted' ? 'Account gelöscht.' : null;
const err = params.get('error');
const errMsg =
  err === 'conflict' ? 'Es liegt bereits ein bestätigtes Ergebnis für dieses Spiel vor.' :
  err === 'score' ? 'Das eingegebene Ergebnis ist ungültig (z. B. 6:3 / 6:4, bei 1:1 ein Match-Tiebreak).' :
  err === 'self' ? 'Du kannst deinen eigenen Account nicht löschen.' :
  err ? 'Aktion fehlgeschlagen.' : null;

const statusLabel: Record<string, string> = { approved: 'freigegeben', pending: 'wartet', rejected: 'gesperrt' };
const fmtDate = (s: string) => s.slice(8, 10) + '.' + s.slice(5, 7) + '. ' + s.slice(11, 16);
---

<Layout title="Admin · Vereinsmeisterschaft">
  <div class="border-b border-deep-ink/10 bg-warm-sand-2/40">
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-2">
      <a href="/" class="auth-nav-link">← Übersicht</a>
      <form method="POST" action="/api/auth/logout"><button type="submit" class="auth-nav-link">Abmelden</button></form>
    </div>
  </div>

  <main class="mx-auto max-w-3xl px-4 py-8">
    <div class="label-mono text-club-blue">Admin</div>
    <h1 class="mt-1 font-serif text-4xl leading-tight text-deep-ink">Dashboard</h1>

    {okMsg && <div class="mt-5 rounded-sm border border-club-blue/30 bg-club-blue/5 px-4 py-3 text-[15px] text-deep-ink">{okMsg}</div>}
    {errMsg && <div class="mt-5 rounded-sm border border-court-red/30 bg-court-red/5 px-4 py-3 text-[15px] text-deep-ink">{errMsg}</div>}

    <section class="mt-8">
      <h2 class="font-serif text-2xl text-deep-ink">Namensansprüche <span class="text-muted-2">({claims.length})</span></h2>
      {claims.length === 0 ? (
        <p class="mt-2 text-muted">Keine offenen Ansprüche.</p>
      ) : (
        <div class="mt-3 grid gap-2">
          {claims.map((c) => (
            <article class="flex items-center justify-between gap-3 rounded-sm border border-deep-ink/12 bg-white/55 p-3">
              <div>
                <div class="font-medium text-deep-ink">{c.player_name}</div>
                <div class="font-mono text-[12px] text-muted-2">{c.email}</div>
              </div>
              <div class="flex gap-2">
                <form method="POST" action="/api/admin/claim">
                  <input type="hidden" name="user_id" value={c.id} />
                  <input type="hidden" name="decision" value="approve" />
                  <button type="submit" class="act-btn approve">Freigeben</button>
                </form>
                <form method="POST" action="/api/admin/claim">
                  <input type="hidden" name="user_id" value={c.id} />
                  <input type="hidden" name="decision" value="reject" />
                  <button type="submit" class="act-btn reject">Ablehnen</button>
                </form>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>

    <section class="mt-10">
      <h2 class="font-serif text-2xl text-deep-ink">Zu klären (abgelehnt) <span class="text-muted-2">({rejected.length})</span></h2>
      <p class="mt-1 text-sm text-muted">Abgelehnte Partien gehen nicht zurück an die Spieler. Trage das richtige Ergebnis ein und bestätige es final.</p>
      {rejected.length === 0 ? (
        <p class="mt-2 text-muted">Nichts zu klären.</p>
      ) : (
        <div class="mt-3 grid gap-2">
          {rejected.map((r) => { const d = describe(r); return (
            <article class="rounded-sm border border-court-red/25 bg-court-red/5 p-3">
              <div class="label-mono text-court-red">{r.wettbewerb} · {d.ctx} · Match {String(r.match_nr).padStart(2,'0')}</div>
              <div class="mt-1 text-deep-ink">{d.title}</div>
              <div class="mt-0.5 text-sm text-muted">
                Eingetragen von {r.submitter ?? '–'}: <span class="font-mono">{d.result}</span> (Sieger {d.winner})
                {r.reject_reason ? ` · Ablehnungsgrund: ${r.reject_reason}` : ''}
              </div>

              <form method="POST" action="/api/admin/result" class="mt-3 grid grid-cols-[1fr_1fr_1fr_auto] items-end gap-2">
                <input type="hidden" name="result_id" value={r.id} />
                <input type="hidden" name="action" value="resolve" />
                <label class="block"><span class="label-mono mb-1 block text-muted-2">Satz 1</span><input class="score-input" name="satz1" value={r.satz1} required placeholder="6:3" /></label>
                <label class="block"><span class="label-mono mb-1 block text-muted-2">Satz 2</span><input class="score-input" name="satz2" value={r.satz2} required placeholder="6:4" /></label>
                <label class="block"><span class="label-mono mb-1 block text-muted-2">MTB</span><input class="score-input" name="mtb" value={r.mtb ?? ''} placeholder="10:7" /></label>
                <button type="submit" class="act-btn approve">Eintragen &amp; bestätigen</button>
              </form>
            </article>
          )})}
        </div>
      )}
    </section>

    <section class="mt-10">
      <h2 class="font-serif text-2xl text-deep-ink">Offene Bestätigungen <span class="text-muted-2">({pending.length})</span></h2>
      {pending.length === 0 ? (
        <p class="mt-2 text-muted">Keine ausstehenden Ergebnisse.</p>
      ) : (
        <div class="mt-3 grid gap-2">
          {pending.map((r) => { const d = describe(r); return (
            <article class="rounded-sm border border-deep-ink/12 bg-white/55 p-3">
              <div class="label-mono text-club-blue">{r.wettbewerb} · {d.ctx} · Match {String(r.match_nr).padStart(2,'0')}</div>
              <div class="mt-1 text-deep-ink">{d.title}</div>
              <div class="mt-0.5 font-mono text-[13px] text-deep-ink">{d.result} · Sieger {d.winner}</div>
              <div class="mt-0.5 text-sm text-muted">Eingetragen von {r.submitter ?? '–'}</div>
              <div class="mt-2 flex gap-2">
                <form method="POST" action="/api/admin/result">
                  <input type="hidden" name="result_id" value={r.id} />
                  <input type="hidden" name="action" value="confirm" />
                  <button type="submit" class="act-btn approve">Bestätigen</button>
                </form>
                <form method="POST" action="/api/admin/result">
                  <input type="hidden" name="result_id" value={r.id} />
                  <input type="hidden" name="action" value="delete" />
                  <button type="submit" class="act-btn reject">Löschen</button>
                </form>
              </div>
            </article>
          )})}
        </div>
      )}
    </section>

    <section class="mt-10">
      <h2 class="font-serif text-2xl text-deep-ink">Registrierte Accounts <span class="text-muted-2">({accounts.length})</span></h2>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-deep-ink/15 text-left">
              <th class="py-2 pr-3 font-mono text-[11px] uppercase tracking-wider text-muted-2">E-Mail</th>
              <th class="py-2 pr-3 font-mono text-[11px] uppercase tracking-wider text-muted-2">Spieler</th>
              <th class="py-2 pr-3 font-mono text-[11px] uppercase tracking-wider text-muted-2">Rolle</th>
              <th class="py-2 pr-3 font-mono text-[11px] uppercase tracking-wider text-muted-2">Status</th>
              <th class="py-2 pr-3 font-mono text-[11px] uppercase tracking-wider text-muted-2">Seit</th>
              <th class="py-2 font-mono text-[11px] uppercase tracking-wider text-muted-2">Aktionen</th>
            </tr>
          </thead>
          <tbody>
            {accounts.map((a) => (
              <tr class="border-b border-deep-ink/8 align-middle">
                <td class="py-2 pr-3 break-all">{a.email}</td>
                <td class="py-2 pr-3">{a.player_name ?? <span class="text-muted-2">–</span>}</td>
                <td class="py-2 pr-3">{a.role === 'admin' ? <span class="font-medium text-club-blue">Admin</span> : 'Spieler'}</td>
                <td class="py-2 pr-3">
                  <span class={`acc-badge ${a.claim_status === 'approved' ? 'ok' : a.claim_status === 'pending' ? 'wait' : 'blocked'}`}>{statusLabel[a.claim_status] ?? a.claim_status}</span>
                </td>
                <td class="py-2 pr-3 whitespace-nowrap font-mono text-[12px] text-muted-2">{fmtDate(a.created_at)}</td>
                <td class="py-2">
                  {a.id === user.id ? (
                    <span class="text-muted-2">(du)</span>
                  ) : (
                    <div class="flex flex-wrap gap-1.5">
                      {a.claim_status !== 'approved' && a.player_name && (
                        <form method="POST" action="/api/admin/claim">
                          <input type="hidden" name="user_id" value={a.id} />
                          <input type="hidden" name="decision" value="approve" />
                          <button type="submit" class="act-btn approve">Freigeben</button>
                        </form>
                      )}
                      {a.claim_status === 'approved' && (
                        <form method="POST" action="/api/admin/claim">
                          <input type="hidden" name="user_id" value={a.id} />
                          <input type="hidden" name="decision" value="reject" />
                          <button type="submit" class="act-btn reject">Sperren</button>
                        </form>
                      )}
                      <form method="POST" action="/api/admin/user" onsubmit="return confirm('Diesen Account wirklich löschen?')">
                        <input type="hidden" name="user_id" value={a.id} />
                        <input type="hidden" name="action" value="delete" />
                        <button type="submit" class="act-btn ghost">Löschen</button>
                      </form>
                    </div>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <style>
    .auth-nav-link {
      cursor: pointer; background: transparent; border: none;
      font-family: var(--font-mono); font-size: 11px; font-weight: 500;
      letter-spacing: 1.1px; text-transform: uppercase; color: var(--color-muted);
    }
    .auth-nav-link:hover { color: var(--color-deep-ink); }
    .act-btn {
      cursor: pointer; min-height: 38px; border-radius: 6px; padding: 0 0.8rem;
      font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: 0.8px; text-transform: uppercase;
      border: 1px solid transparent; color: #fff;
    }
    .act-btn.approve { background: #1f7a4d; border-color: #1f7a4d; }
    .act-btn.reject { background: #b3402f; border-color: #b3402f; }
    .act-btn.ghost { background: transparent; border-color: rgba(26,31,46,0.25); color: var(--color-muted); }
    .act-btn.ghost:hover { border-color: var(--color-court-red); color: var(--color-court-red); }
    .act-btn:active { transform: translateY(1px); }
    .acc-badge {
      display: inline-block; border-radius: 999px; padding: 0.12rem 0.55rem;
      font-family: var(--font-mono); font-size: 10px; font-weight: 500; letter-spacing: 0.5px; text-transform: uppercase;
    }
    .acc-badge.ok { background: rgba(31,122,77,0.14); color: #1f7a4d; }
    .acc-badge.wait { background: rgba(180,120,20,0.14); color: #8a5a10; }
    .acc-badge.blocked { background: rgba(179,64,47,0.14); color: var(--color-court-red); }
    .score-input {
      width: 100%; min-height: 38px; border: 1px solid rgba(26,31,46,0.18); border-radius: 6px;
      padding: 0.4rem 0.5rem; font: inherit; font-family: var(--font-mono);
      background: rgba(255,255,255,0.85); outline: none; text-align: center;
    }
    .score-input:focus { border-color: var(--color-deep-ink); }
  </style>
</Layout>
