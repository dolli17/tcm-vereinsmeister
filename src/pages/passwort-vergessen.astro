---
import AuthShell from '../components/AuthShell.astro';

if (Astro.locals.user) return Astro.redirect('/meine-spiele');
const sent = Astro.url.searchParams.get('sent') === '1';
---

<AuthShell title="Passwort vergessen · Vereinsmeisterschaft" heading="Passwort vergessen" sub="Gib deine E-Mail ein — wir senden dir einen Link zum Zurücksetzen." back={{ href: '/login', label: '← Zur Anmeldung' }}>
  {sent && <div class="notice ok">Wenn ein Account zu dieser E-Mail existiert, ist der Reset-Link unterwegs. Schau in dein Postfach.</div>}

  <form method="POST" action="/api/auth/forgot">
    <label class="field"><span class="lbl">E-Mail</span><input class="input" type="email" name="email" required placeholder="du@example.com" autocomplete="email" /></label>
    <button type="submit" class="btn block">Reset-Link senden</button>
  </form>
</AuthShell>
