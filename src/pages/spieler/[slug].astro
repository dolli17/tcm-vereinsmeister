---
import AppShell from '../../components/AppShell.astro';
import { getActiveSeason, listSeasons } from '../../lib/tournament';
import { getPlayerBySlug, getPlayerCareer, getPlayerStats } from '../../lib/playerStats';
import { getEloFor } from '../../lib/elo';

const name = getPlayerBySlug(Astro.params.slug ?? '');
if (!name) return Astro.redirect('/meine-spiele');

const stats = getPlayerStats(name);
const career = getPlayerCareer(name);
const elo = getEloFor(name);
const season = getActiveSeason();
const seasons = listSeasons();
const initials = name.split(' ').filter(Boolean).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
const partien = stats.competitions.reduce((n, c) => n + c.total, 0);
---

<AppShell active="me" season={season} seasons={seasons} title={`${name} · Spielerstatistik`}>
  <div class="player-hero">
    <span class="avatar">{initials}</span>
    <div style="flex:1;min-width:0">
      <div class="nm">{name}</div>
      <div class="meta">{stats.competitions.map((c) => c.competition.name).join(' · ') || 'Keine Teilnahme'}</div>
    </div>
    <a href="/meine-spiele" class="icon-btn back" aria-label="Zurück">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
    </a>
  </div>

  <div class="section" style="display:flex;gap:10px;margin-bottom:6px">
    <div class="card" style="flex:1;margin:0;padding:14px 10px;text-align:center">
      <div style="font-family:var(--font-mono);font-weight:700;font-size:1.5rem;color:var(--accent)">{partien}</div>
      <div style="font-size:.72rem;color:var(--muted);font-weight:600">Partien</div>
    </div>
    <div class="card" style="flex:1;margin:0;padding:14px 10px;text-align:center">
      <div style="font-family:var(--font-mono);font-weight:700;font-size:1.5rem;color:var(--accent)">{stats.totals.gespielt}</div>
      <div style="font-size:.72rem;color:var(--muted);font-weight:600">gespielt</div>
    </div>
    <div class="card" style="flex:1;margin:0;padding:14px 10px;text-align:center">
      <div style="font-family:var(--font-mono);font-weight:700;font-size:1.5rem;color:var(--accent)">{stats.totals.punkte}</div>
      <div style="font-size:.72rem;color:var(--muted);font-weight:600">Punkte</div>
    </div>
    {elo && (
      <a href="/rangliste" class="card" style="flex:1;margin:0;padding:14px 10px;text-align:center;text-decoration:none;color:inherit">
        <div style="font-family:var(--font-mono);font-weight:700;font-size:1.5rem;color:var(--accent)">{elo.elo}</div>
        <div style="font-size:.72rem;color:var(--muted);font-weight:600">ELO · #{elo.platz}</div>
      </a>
    )}
  </div>

  {career.gespielt > 0 && (
    <div class="section">
      <div class="card" style="padding:14px 16px">
        <div style="display:grid;gap:12px">
          <div>
            <div style="font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px">Form (letzte {career.form.length} Spiele, neueste zuerst)</div>
            <div style="display:flex;gap:5px">
              {career.form.map((won) => (
                <span style={`width:18px;height:18px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:.6rem;font-weight:800;color:#fff;background:${won ? 'var(--accent)' : 'var(--danger)'}`}>{won ? 'S' : 'N'}</span>
              ))}
            </div>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            <div>
              <div style="font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px">Bilanz pro Saison</div>
              {career.seasons.map((s) => (
                <div style="display:flex;justify-content:space-between;font-size:.84rem;padding:2px 0">
                  <span>{s.jahr}</span>
                  <span style="font-family:var(--font-mono)">{s.siege}–{s.gespielt - s.siege}</span>
                </div>
              ))}
              <div style="display:flex;justify-content:space-between;font-size:.84rem;padding:4px 0;border-top:1px solid var(--line);font-weight:700">
                <span>Gesamt</span>
                <span style="font-family:var(--font-mono)">{career.siege}–{career.gespielt - career.siege}</span>
              </div>
            </div>
            <div>
              <div style="font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:5px">Häufigste Gegner</div>
              {career.gegner.map((g) => (
                <div style="display:flex;justify-content:space-between;gap:8px;font-size:.84rem;padding:2px 0">
                  <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{g.name}</span>
                  <span style="font-family:var(--font-mono);white-space:nowrap">{g.siege}–{g.spiele - g.siege}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  )}

  <div class="section">
    {stats.competitions.length === 0 && <div class="empty"><div class="t">Keine Partien</div><div class="d">Für {name} sind in dieser Saison keine Spiele hinterlegt.</div></div>}

    {stats.competitions.map((cs) => (
      <div class="card">
        <div class="card-head">
          <span class="ttl">{cs.competition.name}</span>
          <span class="sub">{cs.gruppe != null ? `Gruppe ${cs.gruppe} · ` : ''}{cs.gespielt}/{cs.total}</span>
        </div>

        {cs.standing && (
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:12px 16px;border-bottom:1px solid var(--line)">
            <div><div style="font-size:.66rem;color:var(--muted);text-transform:uppercase">Platz</div><div style="font-family:var(--font-mono);font-weight:700">{cs.standing.platz}</div></div>
            <div><div style="font-size:.66rem;color:var(--muted);text-transform:uppercase">Pkt</div><div style="font-family:var(--font-mono);font-weight:700">{cs.standing.punkte}</div></div>
            <div><div style="font-size:.66rem;color:var(--muted);text-transform:uppercase">Sätze</div><div style="font-family:var(--font-mono);font-weight:700">{cs.standing.saetzeGewonnen}:{cs.standing.saetzeVerloren}</div></div>
            <div><div style="font-size:.66rem;color:var(--muted);text-transform:uppercase">Games</div><div style="font-family:var(--font-mono);font-weight:700">{cs.standing.spieleGewonnen}:{cs.standing.spieleVerloren}</div></div>
          </div>
        )}

        <div class="matchlist">
          {cs.breakdowns.map((item) => (
            <div class="match">
              <div class="match-body">
                <div style="font-size:.72rem;color:var(--muted);margin-bottom:3px">{item.match.gruppe != null ? `Gruppe ${item.match.gruppe}` : ''}{item.match.monat ? ` · ${item.match.monat}` : ''}</div>
                <div class={`match-side ${item.won ? 'win' : ''}`} style="padding:0"><span class="nm">gegen {item.opponent}</span></div>
              </div>
              <div class="match-meta">
                {item.status === 'gespielt'
                  ? <><span class="score">{item.result}</span><span class="status-tag done">{item.total} Pkt</span></>
                  : <span class="status-tag open">{item.status === 'terminiert' ? 'terminiert' : 'offen'}</span>}
              </div>
            </div>
          ))}
          {cs.teamMatches.map((tm) => (
            <div class="match">
              <div class="match-body">
                <div style="font-size:.72rem;color:var(--muted);margin-bottom:3px">{tm.runde ?? ''} · #{String(tm.nr).padStart(2, '0')}{tm.partner !== 'ohne Partner' ? ` · mit ${tm.partner}` : ''}</div>
                <div class="match-side" style="padding:0"><span class="nm">gegen {tm.opponent}</span></div>
              </div>
              <div class="match-meta">
                {tm.status === 'Gespielt' ? <span class="score">{tm.result}</span>
                  : tm.status === 'Freilos' ? <span class="status-tag done">Freilos</span>
                  : <span class="status-tag open">{tm.status === 'Terminiert' ? 'terminiert' : 'offen'}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</AppShell>
