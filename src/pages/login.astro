---
import Layout from '../layouts/Layout.astro';

if (Astro.locals.user) return Astro.redirect('/meine-spiele');

const params = Astro.url.searchParams;
const error = params.get('error');
const errorMsg =
  error === 'creds' ? 'E-Mail oder Passwort ist falsch.' :
  error === 'exists' ? 'Für diese E-Mail gibt es bereits einen Account. Bitte hier anmelden.' :
  null;
---

<Layout title="Anmelden · Vereinsmeisterschaft">
  <main class="mx-auto flex min-h-dvh max-w-md flex-col justify-center px-4 py-10">
    <a href="/" class="label-mono text-club-blue">← Zur Übersicht</a>
    <h1 class="mt-5 font-serif text-4xl leading-tight text-deep-ink">Anmelden</h1>
    <p class="mt-2 text-[15px] leading-relaxed text-muted">Melde dich mit E-Mail und Passwort an.</p>

    {errorMsg && (
      <div class="mt-6 rounded-sm border border-court-red/30 bg-court-red/5 px-4 py-3 text-[15px] text-deep-ink">{errorMsg}</div>
    )}

    <form method="POST" action="/api/auth/login" class="mt-6 grid gap-3">
      <label class="block">
        <span class="label-mono mb-1.5 block text-muted-2">E-Mail</span>
        <input class="auth-input" type="email" name="email" required placeholder="du@example.com" autocomplete="email" />
      </label>
      <label class="block">
        <span class="label-mono mb-1.5 block text-muted-2">Passwort</span>
        <input class="auth-input" type="password" name="password" required placeholder="••••••••" autocomplete="current-password" />
      </label>
      <button type="submit" class="auth-button">Anmelden</button>
    </form>

    <p class="mt-6 text-sm text-muted">
      Noch kein Account? <a href="/registrieren" class="text-club-blue underline">Hier registrieren</a>
    </p>
  </main>

  <style>
    .auth-input {
      width: 100%; min-height: 48px; border: 1px solid rgba(26, 31, 46, 0.18);
      border-radius: 6px; padding: 0.75rem 0.9rem; color: var(--color-deep-ink);
      background: rgba(255, 255, 255, 0.7); font: inherit; outline: none;
    }
    .auth-input:focus { border-color: var(--color-deep-ink); }
    .auth-button {
      cursor: pointer; min-height: 48px; border-radius: 6px;
      border: 1px solid var(--color-deep-ink); background: var(--color-deep-ink); color: #fff;
      font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 1.2px; text-transform: uppercase;
    }
    .auth-button:active { transform: translateY(1px); }
  </style>
</Layout>
