---
import AuthShell from '../components/AuthShell.astro';

if (Astro.locals.user) return Astro.redirect('/meine-spiele');

const params = Astro.url.searchParams;
const error = params.get('error');
const resetDone = params.get('reset') === '1';
const errorMsg =
  error === 'creds' ? 'E-Mail oder Passwort ist falsch.' :
  error === 'exists' ? 'Für diese E-Mail gibt es bereits einen Account. Bitte hier anmelden.' :
  null;
---

<AuthShell title="Anmelden · Vereinsmeisterschaft" heading="Anmelden" sub="Melde dich mit E-Mail und Passwort an." back={{ href: '/', label: '← Zur Übersicht' }}>
  {resetDone && <div class="notice ok">Passwort geändert. Du kannst dich jetzt anmelden.</div>}
  {errorMsg && <div class="notice err">{errorMsg}</div>}

  <form method="POST" action="/api/auth/login">
    <label class="field"><span class="lbl">E-Mail</span><input class="input" type="email" name="email" required placeholder="du@example.com" autocomplete="email" /></label>
    <label class="field"><span class="lbl">Passwort</span><input class="input" type="password" name="password" required placeholder="••••••••" autocomplete="current-password" /></label>
    <button type="submit" class="btn block">Anmelden</button>
  </form>

  <div class="linkrow"><a href="/passwort-vergessen">Passwort vergessen?</a></div>
  <div class="linkrow">Noch kein Account? <a href="/registrieren">Hier registrieren</a></div>
</AuthShell>
