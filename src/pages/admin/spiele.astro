---
import AdminShell from '../../components/AdminShell.astro';
import { getAllFixturesWithStatus, type AdminFixture } from '../../lib/matchEntry';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
if (user.role !== 'admin') return Astro.redirect('/');

const fixtures = getAllFixturesWithStatus();

const sections: { key: string; items: AdminFixture[] }[] = [];
for (const f of fixtures) {
  const sub = f.gruppe != null ? `Gruppe ${f.gruppe}` : (f.runde ?? '');
  const key = `${f.wettbewerbLabel}${sub ? ' · ' + sub : ''}`;
  let s = sections.find((x) => x.key === key);
  if (!s) { s = { key, items: [] }; sections.push(s); }
  s.items.push(f);
}
for (const s of sections) s.items.sort((a, b) => a.nr - b.nr);

const params = Astro.url.searchParams;
const ok = params.get('ok');
const okMsg = ok === 'saved' ? 'Ergebnis gespeichert.' : ok === 'deleted' ? 'Ergebnis gelöscht.' : null;
const err = params.get('error');
const errMsg = err === 'score' ? 'Ungültiges Ergebnis (z. B. 6:3 / 6:4, bei 1:1 ein Match-Tiebreak).' : err === 'fixture' ? 'Spiel nicht gefunden.' : err ? 'Aktion fehlgeschlagen.' : null;

const statusText: Record<AdminFixture['status'], string> = { open: 'offen', pending: 'wartet', confirmed: 'bestätigt', rejected: 'abgelehnt' };
const statusPill: Record<AdminFixture['status'], string> = { open: 'wait', pending: 'wait', confirmed: 'ok', rejected: 'blocked' };
---

<AdminShell title="Spiele & Ergebnisse · Admin" active="spiele">
  <h1 class="admin-h1">Spiele &amp; Ergebnisse</h1>
  <p style="color:var(--muted);margin-bottom:16px">Ergebnis für jedes Spiel direkt eintragen, korrigieren oder löschen. Admin-Einträge gelten sofort als bestätigt.</p>

  {okMsg && <div class="notice ok">{okMsg}</div>}
  {errMsg && <div class="notice err">{errMsg}</div>}

  <div class="admin-grid">
    {sections.map((sec) => (
      <div class="panel">
        <h2>{sec.key} <span class="ct">{sec.items.filter((m) => m.status === 'confirmed').length}/{sec.items.length}</span></h2>
        <div style="display:flex;flex-direction:column;gap:6px">
          {sec.items.map((m) => (
            <form method="POST" action="/api/admin/enter" class="row-item" style="gap:8px">
              <input type="hidden" name="match_id" value={m.matchId} />
              <div class="grow">
                <div style="font-size:.92rem">
                  <span style="font-family:var(--font-mono);font-size:.72rem;color:var(--muted)">{String(m.nr).padStart(2, '0')}</span>
                  {' '}{m.sideA.join(' / ')} <span style="color:var(--muted)">vs</span> {m.sideB.join(' / ')}
                </div>
                <div style="font-size:.74rem;color:var(--muted)"><span class={`pill ${statusPill[m.status]}`}>{statusText[m.status]}</span>{m.result ? ` ${m.result}` : ''}</div>
              </div>
              <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap" data-entry>
                <select class="input" name="ergebnis_typ" style="min-height:34px;width:7.5rem" aria-label="Ergebnistyp" data-typ>
                  <option value="gespielt" selected={m.ergebnisTyp === 'gespielt'}>Gespielt</option>
                  <option value="wo" selected={m.ergebnisTyp === 'wo'}>Kampflos</option>
                  <option value="aufgabe" selected={m.ergebnisTyp === 'aufgabe'}>Aufgabe</option>
                </select>
                <span data-sets style="display:flex;gap:6px;align-items:center">
                  <input class="score-in" name="satz1" value={m.satz1 ?? ''} placeholder="6:3" aria-label="Satz 1" />
                  <input class="score-in" name="satz2" value={m.satz2 ?? ''} placeholder="6:4" aria-label="Satz 2" />
                  <input class="score-in" name="mtb" value={m.mtb ?? ''} placeholder="MTB" aria-label="Match-Tiebreak" />
                </span>
                <select class="input" name="sieger" style="min-height:34px;max-width:9rem;display:none" aria-label="Sieger" data-winner>
                  <option value="A" selected={m.sieger === 'A'}>{m.sideA.join(' / ')}</option>
                  <option value="B" selected={m.sieger === 'B'}>{m.sideB.join(' / ')}</option>
                </select>
                <button type="submit" name="action" value="save" class="btn sm">Speichern</button>
                {m.status !== 'open' && (
                  <button type="submit" name="action" value="delete" class="btn sm ghost" formnovalidate aria-label="Löschen">✕</button>
                )}
              </div>
            </form>
          ))}
        </div>
      </div>
    ))}
  </div>
</AdminShell>

<script>
  // Ergebnistyp-Umschalter: Kampflos blendet Sätze aus, Sonderfälle brauchen den Sieger.
  document.querySelectorAll<HTMLElement>('[data-entry]').forEach((wrap) => {
    const typ = wrap.querySelector<HTMLSelectElement>('[data-typ]');
    if (!typ) return;
    const apply = () => {
      const t = typ.value;
      wrap.querySelectorAll<HTMLElement>('[data-sets]').forEach((el) => { el.style.display = t === 'wo' ? 'none' : 'flex'; });
      wrap.querySelectorAll<HTMLElement>('[data-winner]').forEach((el) => { el.style.display = t === 'gespielt' ? 'none' : ''; });
    };
    typ.addEventListener('change', apply);
    apply();
  });
</script>
