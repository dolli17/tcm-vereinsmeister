---
import AppShell from '../components/AppShell.astro';
import ScorePicker from '../components/ScorePicker.astro';
import { getActiveSeason, listSeasons } from '../lib/tournament';
import {
  LISTEN,
  fmtDatum,
  forderbareGegner,
  formatChallengeResult,
  getLadderEntries,
  getOpenChallenges,
  reiheVonRang,
  type Challenge,
  type LadderEntry,
  type Liste,
} from '../lib/ladder';
import { getGeschlecht, getPhoneMap } from '../lib/players';
import { formatTermin } from '../lib/termine';

const season = getActiveSeason();
const seasons = listSeasons();
const user = Astro.locals.user;
const approved = !!user?.player_name && user?.claim_status === 'approved';
const me = approved ? user!.player_name! : null;
const geschlecht = me ? getGeschlecht(me) : null;
const eigeneListe: Liste | null = geschlecht === 'm' ? 'herren' : geschlecht === 'w' ? 'damen' : null;

// Vergleichbar mit sqlite datetime('now') (UTC, 'YYYY-MM-DD HH:MM:SS').
const nowSql = new Date().toISOString().replace('T', ' ').slice(0, 19);
const phones = getPhoneMap();
const telDigits = (tel: string) => tel.replace(/[^\d+]/g, '');
const waLink = (tel: string) => {
  const d = telDigits(tel);
  const intl = d.startsWith('+') ? d.slice(1) : d.startsWith('00') ? d.slice(2) : d.startsWith('0') ? `49${d.slice(1)}` : d;
  return `https://wa.me/${intl}`;
};

const data = LISTEN.map((liste) => {
  const entries = getLadderEntries(liste);
  const open = getOpenChallenges(liste);
  const beteiligt = new Map<string, Challenge>();
  for (const c of open) {
    beteiligt.set(c.challenger, c);
    beteiligt.set(c.challenged, c);
  }
  const rows: LadderEntry[][] = [];
  for (const e of entries) {
    const r = reiheVonRang(e.rank);
    (rows[r - 1] ??= []).push(e);
  }
  return { liste, entries, open, beteiligt, rows };
});

const myData = eigeneListe ? data.find((d) => d.liste === eigeneListe)! : null;
const myEntry = me && myData ? (myData.entries.find((e) => e.player_name === me) ?? null) : null;
const myChallenge = me && myData ? (myData.open.find((c) => c.challenger === me || c.challenged === me) ?? null) : null;
const meGesperrt = !!myEntry?.gesperrt_bis && myEntry.gesperrt_bis > nowSql;
const meGeschuetzt = !!myEntry?.geschuetzt_bis && myEntry.geschuetzt_bis > nowSql;
const forderbar = new Set(
  myEntry && myData && !myChallenge && !meGesperrt ? forderbareGegner(myEntry.rank, myData.entries.length) : [],
);

const listeLabel = (l: Liste) => (l === 'herren' ? 'Herren' : 'Damen');
const defaultTab = eigeneListe ?? 'herren';

const params = Astro.url.searchParams;
const ok = params.get('ok');
const okMsg: Record<string, string> = {
  joined: 'Du stehst jetzt auf der Forderungsliste — ganz unten, ab sofort kannst du fordern.',
  left: 'Du wurdest von der Forderungsliste genommen.',
  challenged: 'Forderung ausgesprochen! Dein Gegner wurde informiert — ihr habt 14 Tage Zeit.',
  withdrawn: 'Forderung zurückgezogen.',
  termin: 'Termin gespeichert.',
  entered: 'Ergebnis eingetragen — dein Gegner bestätigt es hier.',
};
const decided = params.get('decided');
const decidedMsg =
  decided === 'accepted' ? 'Ergebnis bestätigt — die Rangliste wurde aktualisiert.' :
  decided === 'rejected' ? 'Ergebnis abgelehnt — der Ranglistenbetreuer wurde informiert.' : null;
const err = params.get('error');
const errMsg: Record<string, string> = {
  notapproved: 'Dein Namensanspruch ist noch nicht freigegeben.',
  geschlecht: 'Bitte hinterlege zuerst dein Geschlecht in den Einstellungen.',
  schon_drauf: 'Du stehst bereits auf der Liste.',
  nicht_drauf: 'Du stehst nicht auf der Liste.',
  offene_forderung: 'Mit offener Forderung ist kein Austritt möglich.',
  gegner_nicht_drauf: 'Dieser Spieler steht nicht auf der Liste.',
  nicht_forderbar: 'Diesen Platz darfst du laut Tannenbaum-System nicht fordern.',
  eigene_offene: 'Du hast bereits eine offene Forderung.',
  gegner_offene: 'Dein Wunschgegner steckt bereits in einer offenen Forderung.',
  gesperrt: 'Du bist nach einer verlorenen Forderung noch 7 Tage gesperrt.',
  geschuetzt: 'Dieser Spieler ist als Sieger noch 2 Tage vor Forderungen geschützt.',
  max_pro_saison: 'Du hast diesen Spieler in dieser Saison bereits zweimal gefordert.',
  gone: 'Diese Forderung wurde bereits bearbeitet.',
  notyours: 'Diese Forderung gehört nicht zu dir.',
  ownresult: 'Dein eigenes Ergebnis kann nur der Gegner bestätigen.',
  score: 'Das Ergebnis konnte nicht gelesen werden (z. B. 6:3, bei 1:1 Match-Tiebreak).',
  zu_spaet: 'Rückzug nicht mehr möglich (weniger als 24 h bis zum Termin).',
  termin: 'Bitte einen gültigen Termin wählen.',
  input: 'Aktion fehlgeschlagen.',
};
---

<AppShell active="ladder" season={season} seasons={seasons} title="Forderungsliste · TC Muckensturm">
  <div class="section-title">Forderungsliste</div>
  <div class="section-sub">Tannenbaum-System: fordere Spieler links in deiner Reihe oder in der Reihe darüber. Sieg = du übernimmst den Platz. <a href="/regeln#forderung" style="color:var(--accent);font-weight:700">Regeln</a></div>

  <div class="section">
    {ok && okMsg[ok] && <div class="notice ok">{okMsg[ok]}</div>}
    {decidedMsg && <div class="notice ok">{decidedMsg}</div>}
    {err && <div class="notice err">{errMsg[err] ?? 'Es ist ein Fehler aufgetreten.'}</div>}

    {!user && <p class="section-sub" style="padding:0 0 10px"><a href="/login" style="color:var(--accent);font-weight:700">Melde dich an</a>, um an der Forderungsliste teilzunehmen.</p>}
    {user && !approved && <div class="notice err">Sobald dein Namensanspruch freigegeben ist, kannst du an der Forderungsliste teilnehmen.</div>}
    {approved && !eigeneListe && (
      <div class="notice err">Bitte hinterlege dein Geschlecht in den <a href="/einstellungen" style="color:var(--accent);font-weight:700">Einstellungen</a>, um teilzunehmen.</div>
    )}

    {/* Eigene offene Forderung */}
    {me && myChallenge && (() => {
      const c = myChallenge;
      const ichForderer = c.challenger === me;
      const gegner = ichForderer ? c.challenged : c.challenger;
      const ichHabeEingetragen = c.eingetragen_von === user!.id;
      return (
        <div class="card" style="padding:14px 16px;margin-bottom:14px;border-color:var(--accent)">
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px">
            <span class="status-tag done" style="background:var(--accent-soft);color:var(--accent)">Deine Forderung</span>
            <span style="font-size:.78rem;color:var(--muted)">Frist: {fmtDatum(c.deadline)}</span>
          </div>
          <div style="font-weight:700;font-size:1rem">{ichForderer ? `Du forderst ${gegner}` : `${gegner} fordert dich`}</div>
          {c.termin && <div style="font-size:.8rem;margin-top:4px">Termin: {formatTermin(c.termin)}</div>}
          {phones[gegner] && c.status === 'offen' && (
            <div style="display:flex;gap:6px;margin-top:8px">
              <a class="btn sm ghost" href={waLink(phones[gegner])} target="_blank" rel="noopener">WhatsApp</a>
              <a class="btn sm ghost" href={`tel:${telDigits(phones[gegner])}`}>Anrufen</a>
            </div>
          )}

          {c.status === 'offen' && (
            <>
              <form method="POST" action="/api/ladder" style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap;margin-top:10px">
                <input type="hidden" name="action" value="termin" />
                <input type="hidden" name="challenge_id" value={c.id} />
                <label style="display:block"><span style="font-size:.66rem;color:var(--muted);display:block;margin-bottom:3px">Termin {c.termin ? 'ändern' : 'festhalten'}</span><input class="input" style="min-height:36px" type="datetime-local" name="termin" /></label>
                <button class="btn sm ghost">Speichern</button>
              </form>
              <form method="POST" action="/api/ladder" style="margin-top:10px;display:grid;gap:10px" data-entry>
                <input type="hidden" name="action" value="enter" />
                <input type="hidden" name="challenge_id" value={c.id} />
                <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
                  <label style="display:block"><span class="pick-lbl">Typ</span>
                    <select class="input" name="ergebnis_typ" style="min-height:42px" data-typ>
                      <option value="gespielt">Gespielt</option>
                      <option value="wo">Kampflos (w.o.)</option>
                      <option value="aufgabe">Aufgabe</option>
                    </select>
                  </label>
                  <label style="display:none" data-winner><span class="pick-lbl">Sieger</span>
                    <select class="input" name="sieger_rel" style="min-height:42px">
                      <option value="me">Ich</option>
                      <option value="opp">{gegner}</option>
                    </select>
                  </label>
                </div>
                <ScorePicker gegner={gegner.split(' ')[0]} />
                <div><button type="submit" class="btn sm">Ergebnis eintragen</button></div>
              </form>
              {ichForderer && (
                <form method="POST" action="/api/ladder" style="margin-top:10px" onsubmit="return confirm('Forderung wirklich zurückziehen?')">
                  <input type="hidden" name="action" value="withdraw" />
                  <input type="hidden" name="challenge_id" value={c.id} />
                  <button class="btn sm ghost">Forderung zurückziehen</button>
                </form>
              )}
            </>
          )}

          {c.status === 'ergebnis_pending' && (
            <div style="margin-top:8px">
              <div class="score">{formatChallengeResult(c)} · Sieger: {c.sieger === 'challenger' ? c.challenger : c.challenged}</div>
              {ichHabeEingetragen ? (
                <div style="font-size:.8rem;color:var(--muted);margin-top:6px">Du hast eingetragen — warte auf die Bestätigung von {gegner}.</div>
              ) : (
                <div style="display:flex;gap:8px;margin-top:8px">
                  <form method="POST" action="/api/ladder"><input type="hidden" name="action" value="decide" /><input type="hidden" name="challenge_id" value={c.id} /><input type="hidden" name="decision" value="accept" /><button class="btn sm lime">Bestätigen</button></form>
                  <form method="POST" action="/api/ladder"><input type="hidden" name="action" value="decide" /><input type="hidden" name="challenge_id" value={c.id} /><input type="hidden" name="decision" value="reject" /><button class="btn sm danger">Ablehnen</button></form>
                </div>
              )}
            </div>
          )}
        </div>
      );
    })()}

    {/* Status-Hinweise */}
    {myEntry && meGesperrt && <div class="notice err">Forderungssperre nach Niederlage — bis {fmtDatum(myEntry.gesperrt_bis)} kannst du nicht fordern.</div>}
    {myEntry && meGeschuetzt && <div class="notice ok">Siegerrechte: Du bist bis {fmtDatum(myEntry.geschuetzt_bis)} vor Forderungen geschützt und darfst sofort erneut fordern.</div>}

    <div class="disc-rail">
      {data.map((d) => (
        <button class="disc-chip" data-on={d.liste === defaultTab ? '1' : '0'} data-disc={d.liste}>
          <span class="dot"></span>{listeLabel(d.liste)} ({d.entries.length})
        </button>
      ))}
    </div>

    {data.map((d) => (
      <div data-panel={d.liste} hidden={d.liste !== defaultTab}>
        {approved && eigeneListe === d.liste && !myEntry && (
          <form method="POST" action="/api/ladder" style="margin-bottom:14px">
            <input type="hidden" name="action" value="join" />
            <button class="btn block lime">In die {listeLabel(d.liste)}-Forderungsliste eintragen</button>
          </form>
        )}

        {d.entries.length === 0 ? (
          <div class="empty"><div class="t">Noch leer</div><div class="d">Sei die/der Erste auf der {listeLabel(d.liste)}-Liste!</div></div>
        ) : (
          <div style="overflow-x:auto;padding:4px 0">
            {d.rows.map((row) => (
              <div style="display:flex;justify-content:center;gap:6px;margin-bottom:6px">
                {row.map((e) => {
                  const inDuell = d.beteiligt.get(e.player_name);
                  const geschuetzt = !!e.geschuetzt_bis && e.geschuetzt_bis > nowSql;
                  const kannFordern = me != null && eigeneListe === d.liste && forderbar.has(e.rank) && !inDuell && !geschuetzt;
                  const istIch = e.player_name === me;
                  return (
                    <div class="card" style={`margin:0;padding:7px 10px;min-width:120px;text-align:center;${istIch ? 'border-color:var(--accent);' : ''}${kannFordern ? 'border-style:dashed;' : ''}`}>
                      <div style="font-family:var(--font-mono);font-size:.68rem;color:var(--muted)">#{e.rank}</div>
                      <div style="font-weight:600;font-size:.85rem;white-space:nowrap">{e.player_name}</div>
                      <div style="display:flex;gap:4px;justify-content:center;margin-top:3px;flex-wrap:wrap">
                        {inDuell && <span class="status-tag open" title={`Forderung läuft: ${inDuell.challenger} vs ${inDuell.challenged}`}>⚔</span>}
                        {geschuetzt && <span class="status-tag done" title="Sieger — 2 Tage geschützt">🛡</span>}
                        {kannFordern && (
                          <form method="POST" action="/api/ladder" onsubmit={`return confirm('${e.player_name} (Platz ${e.rank}) fordern? Ihr habt dann 14 Tage Zeit.')`}>
                            <input type="hidden" name="action" value="challenge" />
                            <input type="hidden" name="challenged" value={e.player_name} />
                            <button class="btn sm lime" style="padding:2px 10px">Fordern</button>
                          </form>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            ))}
          </div>
        )}

        {d.open.length > 0 && (
          <div class="card" style="padding:12px 16px;margin-top:12px">
            <h2 class="section-title" style="padding:0 0 8px;font-size:1.1rem">Laufende Forderungen</h2>
            {d.open.map((c) => (
              <div style="display:flex;justify-content:space-between;gap:8px;font-size:.85rem;padding:4px 0;border-bottom:1px solid var(--line);flex-wrap:wrap">
                <span><b>{c.challenger}</b> fordert <b>{c.challenged}</b>{c.status === 'ergebnis_pending' ? ' · Ergebnis wartet auf Bestätigung' : ''}</span>
                <span style="font-family:var(--font-mono);color:var(--muted);white-space:nowrap">bis {fmtDatum(c.deadline)}{c.termin ? ` · ${formatTermin(c.termin)}` : ''}</span>
              </div>
            ))}
          </div>
        )}

        {approved && eigeneListe === d.liste && myEntry && !myChallenge && (
          <form method="POST" action="/api/ladder" style="margin-top:14px;text-align:center" onsubmit="return confirm('Wirklich von der Forderungsliste austreten? Du verlierst deinen Platz.')">
            <input type="hidden" name="action" value="leave" />
            <button class="btn sm ghost">Von der Liste austreten</button>
          </form>
        )}
      </div>
    ))}
  </div>

  <p class="section-sub" style="text-align:center;padding:18px 0 8px;display:flex;gap:18px;justify-content:center;flex-wrap:wrap">
    <a href="/regeln#forderung" style="color:var(--blue);font-weight:700;text-decoration:none">Forderungs-Regeln</a>
  </p>
</AppShell>

<script>
  // Listen-Tabs (Herren/Damen)
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-disc]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => (c.dataset.on = c === chip ? '1' : '0'));
    panels.forEach((p) => { p.hidden = p.dataset.panel !== chip.dataset.disc; });
  }));

  // Eintragungs-Logik (Satz-Picker, MTB bei 1:1, wo/aufgabe) liegt in ScorePicker.astro.
</script>
