---
import AuthShell from '../components/AuthShell.astro';
import { getDb } from '../lib/db';

if (Astro.locals.user) return Astro.redirect('/meine-spiele');

// Nur Spieler anzeigen, die hinterlegt und noch NICHT registriert sind.
const names = (getDb().prepare(`
  SELECT p.name FROM players p
  WHERE p.name NOT IN (
    SELECT player_name FROM users
    WHERE player_name IS NOT NULL AND claim_status IN ('approved','pending')
  )
  ORDER BY p.name COLLATE NOCASE
`).all() as { name: string }[]).map((r) => r.name);

const params = Astro.url.searchParams;
const error = params.get('error');
const errorMsg =
  error === 'email' ? 'Bitte gib eine gültige E-Mail-Adresse ein.' :
  error === 'pwlen' ? 'Das Passwort muss mindestens 8 Zeichen haben.' :
  error === 'pwmatch' ? 'Die Passwörter stimmen nicht überein.' :
  error === 'name' ? 'Bitte wähle deinen Namen aus der Liste.' :
  error === 'nametaken' ? 'Für diesen Namen gibt es bereits eine Registrierung. Bitte melde dich an oder kontaktiere den Sportwart.' :
  null;
---

<AuthShell title="Registrieren · Vereinsmeisterschaft" heading="Registrieren" sub="Wähle deinen Namen, gib deine E-Mail an und lege ein Passwort fest. Ein Admin bestätigt anschließend, dass der Name zu dir gehört." back={{ href: '/', label: '← Zur Übersicht' }}>
  {errorMsg && <div class="notice err">{errorMsg}</div>}

  <form method="POST" action="/api/auth/register">
    <label class="field">
      <span class="lbl">Dein Name</span>
      <select class="input" name="player_name" required>
        <option value="" disabled selected>Namen auswählen …</option>
        {names.map((n) => <option value={n}>{n}</option>)}
      </select>
      <span style="display:block;margin-top:6px;font-size:.78rem;color:var(--muted)">Es werden nur hinterlegte, noch freie Spieler aufgelistet ({names.length} verfügbar).</span>
    </label>
    <label class="field"><span class="lbl">E-Mail</span><input class="input" type="email" name="email" required placeholder="du@example.com" autocomplete="email" /></label>
    <label class="field"><span class="lbl">Passwort (min. 8 Zeichen)</span><input class="input" type="password" name="password" required minlength="8" placeholder="••••••••" autocomplete="new-password" /></label>
    <label class="field"><span class="lbl">Passwort wiederholen</span><input class="input" type="password" name="password2" required minlength="8" placeholder="••••••••" autocomplete="new-password" /></label>
    <button type="submit" class="btn block">Registrieren</button>
  </form>

  <div class="linkrow">Schon registriert? <a href="/login">Hier anmelden</a></div>
</AuthShell>
