---
import Layout from '../layouts/Layout.astro';
import { getDb } from '../lib/db';

if (Astro.locals.user) return Astro.redirect('/meine-spiele');

// Nur Spieler anzeigen, die in der App hinterlegt und noch NICHT registriert sind
// (bereits vergebene Namen mit offenem/bestätigtem Anspruch ausblenden).
const names = (getDb().prepare(`
  SELECT p.name FROM players p
  WHERE p.name NOT IN (
    SELECT player_name FROM users
    WHERE player_name IS NOT NULL AND claim_status IN ('approved','pending')
  )
  ORDER BY p.name COLLATE NOCASE
`).all() as { name: string }[]).map((r) => r.name);

const params = Astro.url.searchParams;
const error = params.get('error');
const errorMsg =
  error === 'email' ? 'Bitte gib eine gültige E-Mail-Adresse ein.' :
  error === 'pwlen' ? 'Das Passwort muss mindestens 8 Zeichen haben.' :
  error === 'pwmatch' ? 'Die Passwörter stimmen nicht überein.' :
  error === 'name' ? 'Bitte wähle deinen Namen aus der Liste.' :
  error === 'nametaken' ? 'Für diesen Namen gibt es bereits eine Registrierung. Bitte melde dich an oder kontaktiere den Sportwart.' :
  null;
---

<Layout title="Registrieren · Vereinsmeisterschaft">
  <main class="mx-auto flex min-h-dvh max-w-md flex-col justify-center px-4 py-10">
    <a href="/" class="label-mono text-club-blue">← Zur Übersicht</a>
    <h1 class="mt-5 font-serif text-4xl leading-tight text-deep-ink">Registrieren</h1>
    <p class="mt-2 text-[15px] leading-relaxed text-muted">
      Wähle deinen Namen, gib deine E-Mail an und lege ein Passwort fest. Ein Admin bestätigt
      anschließend, dass der Name zu dir gehört — danach kannst du deine Ergebnisse eintragen.
    </p>

    {errorMsg && (
      <div class="mt-6 rounded-sm border border-court-red/30 bg-court-red/5 px-4 py-3 text-[15px] text-deep-ink">{errorMsg}</div>
    )}

    <form method="POST" action="/api/auth/register" class="mt-6 grid gap-3">
      <label class="block">
        <span class="label-mono mb-1.5 block text-muted-2">Dein Name</span>
        <input class="auth-input" name="player_name" list="player-names" required placeholder="Namen tippen und auswählen" autocomplete="off" />
        <datalist id="player-names">
          {names.map((n) => <option value={n} />)}
        </datalist>
        <span class="mt-1 block text-[13px] text-muted">Tippe deinen Namen — es werden nur hinterlegte, noch freie Spieler vorgeschlagen ({names.length} verfügbar).</span>
      </label>
      <label class="block">
        <span class="label-mono mb-1.5 block text-muted-2">E-Mail</span>
        <input class="auth-input" type="email" name="email" required placeholder="du@example.com" autocomplete="email" />
      </label>
      <label class="block">
        <span class="label-mono mb-1.5 block text-muted-2">Passwort (min. 8 Zeichen)</span>
        <input class="auth-input" type="password" name="password" required minlength="8" placeholder="••••••••" autocomplete="new-password" />
      </label>
      <label class="block">
        <span class="label-mono mb-1.5 block text-muted-2">Passwort wiederholen</span>
        <input class="auth-input" type="password" name="password2" required minlength="8" placeholder="••••••••" autocomplete="new-password" />
      </label>
      <button type="submit" class="auth-button">Registrieren</button>
    </form>

    <p class="mt-6 text-sm text-muted">
      Schon registriert? <a href="/login" class="text-club-blue underline">Hier anmelden</a>
    </p>
  </main>

  <style>
    .auth-input {
      width: 100%; min-height: 48px; border: 1px solid rgba(26, 31, 46, 0.18);
      border-radius: 6px; padding: 0.75rem 0.9rem; color: var(--color-deep-ink);
      background: rgba(255, 255, 255, 0.7); font: inherit; outline: none;
    }
    .auth-input:focus { border-color: var(--color-deep-ink); }
    .auth-button {
      cursor: pointer; min-height: 48px; border-radius: 6px;
      border: 1px solid var(--color-deep-ink); background: var(--color-deep-ink); color: #fff;
      font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 1.2px; text-transform: uppercase;
    }
    .auth-button:active { transform: translateY(1px); }
  </style>
</Layout>
