---
import AppShell from '../components/AppShell.astro';
import GruppenCard from '../components/GruppenCard.astro';
import KOView from '../components/KOView.astro';
import {
  getCompetitions,
  getEnrichedMatches,
  getGruppen,
  isPlayed,
  listSeasons,
  monthIndex,
  resolveSeason,
  teamPlayers,
} from '../lib/tournament';
import { formatResult } from '../lib/standings';

const jahrParam = Number(Astro.url.searchParams.get('saison'));
const season = resolveSeason(Number.isFinite(jahrParam) && jahrParam > 0 ? jahrParam : null);
const seasons = listSeasons();
const competitions = season ? getCompetitions(season.id) : [];

const result = formatResult;

// Render-Daten je Konkurrenz vorbereiten (Matches nur einmal laden).
const panels = competitions.map((comp) => {
  const matches = getEnrichedMatches(comp.id);
  if (comp.modus === 'gruppe') {
    const gruppen = getGruppen(comp.id);
    const monate = Array.from(new Set(matches.map((m) => m.monat).filter((mo): mo is string => !!mo)))
      .sort((a, b) => monthIndex(a) - monthIndex(b));
    const planByMonth = [...monate, ''].map((mo) => ({
      monat: mo,
      // '' sammelt Spiele ohne Fälligkeitsmonat ("Termin offen") — sie müssen
      // im Spielplan sichtbar bleiben.
      list: matches.filter((m) => (m.monat ?? '') === mo).sort((a, b) => a.nr - b.nr),
    })).filter((g) => g.list.length > 0);
    // KO-Phase nach der Gruppenphase: Spiele mit Runde statt Gruppe.
    const hatKo = matches.some((m) => m.runde != null);
    return { comp, kind: 'gruppe' as const, matches, gruppen, monate, planByMonth, hatKo };
  }
  return { comp, kind: 'ko' as const, matches, gruppen: [], monate: [], planByMonth: [], hatKo: true };
});

// Fortschritt über alle Konkurrenzen (Freilose/Platzhalter ausgenommen).
let done = 0, total = 0;
for (const p of panels) {
  for (const m of p.matches) {
    if (teamPlayers(m.sideA).length === 0 || teamPlayers(m.sideB).length === 0) continue;
    total++; if (isPlayed(m)) done++;
  }
}
const stati = ['Alle', 'Offen', 'Gespielt'];
---

<AppShell active="comp" season={season} seasons={seasons} showProgress={true} done={done} total={total}>
  {competitions.length === 0 ? (
    <div class="empty" style="padding-top:64px">
      <div class="t">Keine Konkurrenzen</div>
      <div class="d">Für diese Saison sind noch keine Konkurrenzen angelegt.</div>
    </div>
  ) : (
    <>
      <div class="disc-rail">
        {panels.map((p, i) => (
          <button class="disc-chip" data-on={i === 0 ? '1' : '0'} data-disc={i}>
            <span class="dot"></span>{p.comp.name}
          </button>
        ))}
      </div>

      {panels.map((p, i) => (
        <div data-panel={i} hidden={i !== 0}>
          {p.kind === 'gruppe' ? (
            <>
              <div class="section">
                <div class="seg">
                  <button data-view="tab" data-on="1">Tabellen</button>
                  <button data-view="plan" data-on="0">Spielplan</button>
                  {p.hatKo && <button data-view="ko" data-on="0">K.o.-Runde</button>}
                </div>
              </div>

              <div data-sub="tab">
                <div class="section">
                  {p.gruppen.map((g, gi) => <GruppenCard competition={p.comp} gruppe={g} index={gi} />)}
                </div>
                <div class="legend"><span class="swatch"></span> Markierte Plätze qualifizieren sich für die K.o.-Runde</div>
              </div>

              <div data-sub="plan" hidden>
                <div class="filter-bar">
                  {['Alle', ...p.monate].map((mo) => (
                    <button class="fchip" data-month={mo} data-on={mo === 'Alle' ? '1' : '0'}>{mo}</button>
                  ))}
                  <span style="width:1px;background:var(--line);flex-shrink:0;margin:2px 2px"></span>
                  {stati.map((s) => (
                    <button class="fchip" data-status={s.toLowerCase()} data-on={s === 'Alle' ? '1' : '0'}>{s}</button>
                  ))}
                </div>
                <div class="section">
                  {p.planByMonth.map((mg) => (
                    <div data-monthgroup={mg.monat}>
                      <div class="month-head"><span class="m">{mg.monat || 'Termin offen'}</span><span class="ln"></span><span class="ct">{mg.list.length} Spiele</span></div>
                      <div class="card" style="margin-bottom:18px"><div class="matchlist">
                        {mg.list.map((m) => (
                          <div class="match" data-match data-status={isPlayed(m) ? 'gespielt' : 'offen'}>
                            <div class="match-no">#{m.nr}</div>
                            <div class="match-body">
                              <div class={`match-side ${m.sieger === 'A' ? 'win' : ''}`}><span class="nm">{m.sideA}</span></div>
                              <div class="match-vs">{m.gruppe != null ? `Gruppe ${m.gruppe}` : m.runde ?? 'K.o.'}</div>
                              <div class={`match-side ${m.sieger === 'B' ? 'win' : ''}`}><span class="nm">{m.sideB}</span></div>
                            </div>
                            <div class="match-meta">
                              {isPlayed(m)
                                ? <><span class="score">{result(m)}</span><span class="status-tag done">gespielt</span></>
                                : <span class="status-tag open">offen</span>}
                            </div>
                          </div>
                        ))}
                      </div></div>
                    </div>
                  ))}
                </div>
              </div>

              {p.hatKo && (
                <div data-sub="ko" hidden>
                  <div class="section-sub">K.o.-Runde der Gruppenbesten · Auslosung vor Ort</div>
                  <KOView competition={p.comp} />
                </div>
              )}
            </>
          ) : (
            <>
              <div class="section-title">{p.comp.name}</div>
              <div class="section-sub">K.o.-System · Sieger rücken vor, Verlierer scheiden aus</div>
              <KOView competition={p.comp} />
            </>
          )}
        </div>
      ))}
    </>
  )}

  <p class="section-sub" style="text-align:center;padding:18px 0 8px;display:flex;gap:18px;justify-content:center;flex-wrap:wrap">
    <a href="/regeln" style="color:var(--accent);font-weight:700;text-decoration:none">📖 Regeln &amp; Punktesystem</a>
    <a href="/rangliste" style="color:var(--accent);font-weight:700;text-decoration:none">📈 Ewige Rangliste</a>
    {seasons.some((s) => s.status === 'archiviert') && (
      <a href="/archiv" style="color:var(--accent);font-weight:700;text-decoration:none">🏆 Saison-Archiv</a>
    )}
  </p>
</AppShell>

<script>
  // Disziplin-Chips → Panel umschalten
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-disc]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel]');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const i = chip.dataset.disc;
    chips.forEach((c) => c.dataset.on = c === chip ? '1' : '0');
    panels.forEach((p) => { p.hidden = p.dataset.panel !== i; });
  }));

  // Tabellen/Spielplan/K.o.-Umschalter je Panel
  document.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
    const segBtns = panel.querySelectorAll<HTMLButtonElement>('[data-view]');
    const subs = panel.querySelectorAll<HTMLElement>('[data-sub]');
    segBtns.forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.view;
      segBtns.forEach((x) => x.dataset.on = x === b ? '1' : '0');
      subs.forEach((s) => { s.hidden = s.dataset.sub !== v; });
    }));

    // Filter (Monat/Status) im Spielplan
    let fMonth = 'Alle', fStatus = 'alle';
    const apply = () => {
      panel.querySelectorAll<HTMLElement>('[data-match]').forEach((row) => {
        const group = row.closest<HTMLElement>('[data-monthgroup]');
        const mo = group?.dataset.monthgroup ?? '';
        const monthOk = fMonth === 'Alle' || mo === fMonth;
        const statusOk = fStatus === 'alle' || row.dataset.status === fStatus;
        row.hidden = !(monthOk && statusOk);
      });
      panel.querySelectorAll<HTMLElement>('[data-monthgroup]').forEach((g) => {
        const rows = Array.from(g.querySelectorAll<HTMLElement>('[data-match]'));
        g.hidden = rows.length > 0 && rows.every((r) => r.hidden);
      });
    };
    panel.querySelectorAll<HTMLButtonElement>('[data-month]').forEach((b) => b.addEventListener('click', () => {
      fMonth = b.dataset.month ?? 'Alle';
      panel.querySelectorAll<HTMLButtonElement>('[data-month]').forEach((x) => x.dataset.on = x === b ? '1' : '0');
      apply();
    }));
    panel.querySelectorAll<HTMLButtonElement>('[data-status]').forEach((b) => b.addEventListener('click', () => {
      fStatus = b.dataset.status ?? 'alle';
      panel.querySelectorAll<HTMLButtonElement>('[data-status]').forEach((x) => x.dataset.on = x === b ? '1' : '0');
      apply();
    }));
  });

  // Gruppen-Spielplan ausklappen
  document.querySelectorAll<HTMLButtonElement>('[data-collapse]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const el = document.getElementById(btn.dataset.collapse!);
      if (!el) return;
      const open = el.getAttribute('data-open') === '1';
      el.setAttribute('data-open', open ? '0' : '1');
      btn.setAttribute('data-open', open ? '0' : '1');
      btn.firstChild && (btn.childNodes[0].textContent = open ? 'Gruppen-Spielplan ansehen ' : 'Spielplan verbergen ');
    });
  });
</script>
