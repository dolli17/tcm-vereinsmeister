# ── Konfiguration der Vereinsmeisterschaft-App ──────────────────────────────
# Diese Datei nach .env kopieren und ausfüllen. Die .env wird NICHT committet.

# Öffentliche Adresse der App. Bestimmt die Links in den Hinweis-E-Mails
# (Verweis auf „Meine Spiele"). Testphase: http://<VPS-IP>:<APP_PORT>. Cutover: https://<domain>.
SITE_URL=http://DEINE-VPS-IP:8080

# Port, auf dem der Container nach außen erreichbar ist (siehe docker-compose).
APP_PORT=8080

# Resend (E-Mail). Ohne Key werden Mails nur in die Container-Logs geschrieben
# (praktisch zum Testen). Für echten Versand Key bei resend.com erstellen.
RESEND_API_KEY=
# Absender. Bis die Domain bei Resend verifiziert ist, Sandbox-Absender nutzen:
MAIL_FROM=TC Muckensturm <onboarding@resend.dev>

# Admin-Accounts (kommagetrennt). Diese E-Mails bekommen beim Start die Admin-Rolle.
ADMIN_EMAILS=lucas.dollmann2003@gmail.com

# Session-Cookie nur über HTTPS senden. Testphase (HTTP/IP): false. Cutover: true.
COOKIE_SECURE=false

# Geheimnis für den Erinnerungs-Cron (/api/cron/reminders?key=...). Per Cron täglich
# aufrufen; der Endpoint sendet nur gegen Monatsende. Erzeugen: openssl rand -hex 24
CRON_SECRET=

# Agenten-API (siehe API.md): kommagetrennte name:token-Paare. Jeder Token agiert
# mit Admin-Rechten; der Name erscheint im Audit-Log. Leer = API deaktiviert.
# Token erzeugen: openssl rand -hex 24
API_TOKENS=
